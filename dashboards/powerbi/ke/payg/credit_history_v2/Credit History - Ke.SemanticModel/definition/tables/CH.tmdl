	column aging_paid = ```
			
			IF (CH[paidDate] < DATE(YEAR(CH[expected_date]),MONTH(CH[expected_date]),1),"Advance",
			IF(EOMONTH(CH[paidDate],0) = EOMONTH(CH[expected_date],0),"Current", 
			IF(CH[days_to_pay]>0&&CH[days_to_pay]<=30,"1-30 Days Late",
			IF(CH[days_to_pay]>30&&CH[days_to_pay]<=60,"31-60 Days Late",
			IF(CH[days_to_pay]>60&&CH[days_to_pay]<=90,"61-90 Days Late",
			IF(CH[days_to_pay]>90,"91+ Days Late","Advance"))))))
			```
		lineageTag: b9ef9197-309a-42fe-b541-311ca950a5cd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column expected_date = RELATED(installment_schedules[expectedDate])
		formatString: General Date
		lineageTag: f63343c3-1422-41b1-9222-f2eae402aa94
		summarizeBy: none

		variation Variation
			isDefault
			relationship: c833438b-7f3a-4970-b08c-814e02f81874
			defaultHierarchy: LocalDateTable_7fcbca22-e945-4c21-bba0-c050b6e0287b.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column days_to_pay = IF(OR(ISBLANK(CH[paidDate]), ISBLANK(CH[expected_date])),BLANK(),(CH[expected_date] - CH[paiddate])*-1.)
		lineageTag: c8f62b61-5691-46c4-a3f1-6bba8c510931
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column aging_paid_parent =
			
			IF (CH[paidDate] < DATE(YEAR(CH[expected_date]),MONTH(CH[expected_date]),1),"Advance",
			IF(EOMONTH(CH[paidDate],0) = EOMONTH(CH[expected_date],0),"Current",
			IF(ISBLANK(CH[expected_date]), "Advance",
			IF(CH[days_to_pay]>0, "Arrears","Advance"))))
		lineageTag: 175fafc4-bd3d-4195-800d-ec779264de3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column amt_paid_advance = IF(CH[aging_paid]="Advance",CH[amtPaid],BLANK())
		lineageTag: 05828714-54e0-47c1-bb4b-e9d261fc4eaa
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column amt_paid_arrears = IF(CH[aging_paid]="1-30 Days Late" || CH[aging_paid]="31-60 Days Late" ||  CH[aging_paid]="61-90 Days Late" ||  CH[aging_paid]="91+ Days Late" ,CH[amtPaid], BLANK())
		lineageTag: fe524147-fb97-468e-8705-2a1cf9a2bf76
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column amt_paid_current = IF(CH[aging_paid]="Current", CH[amtPaid], BLANK())
		lineageTag: 98e2dcd9-b45d-4d46-8fe1-c94c9295b58b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column amtPaid = CH[amtPaid Ledger]-CH[amtRefund]
		lineageTag: 946c5097-9243-4416-9d87-2e4eaada8bec
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

