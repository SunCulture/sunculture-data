		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition calendar3 = calculated
		mode: import
		source = ```
				ADDCOLUMNS (CALENDAR(MIN(schedule[installment_date]),MAX(schedule[installment_date])),
				    "Year", FORMAT([Date], "yyyy"), 
				    "YearMonthNo", FORMAT([Date],"YYYYMM"),
				    "MonthNo", MONTH([Date]), 
				    "Month", FORMAT([Date],"MMM"),
				    "Quarter", FORMAT([Date],"\QQ"),
				    "MonthYear", FORMAT([Date],"MMM YYYY"), 
				    "WeekdayNo", WEEKDAY([Date],2), //1-Sun..Sat, 2-Mon..Sat
				    "Weekday", FORMAT([Date],"ddd"), 
				    "WeekNo", WEEKNUM([Date], 2),
				    "WeekInMonth","W"&  WEEKNUM ([Date]-1)-WEEKNUM(EOMONTH([Date],-1)+1),
				    "Week", "Week " & WEEKNUM([Date], 2),
				"WeekstartDate", ([Date])-WEEKDAY([Date],3),
				"WeekEndDate", ([Date]+6)-WEEKDAY([Date],3),
				"YearWeekNo",FORMAT([Date],"YYYY")&""&WEEKNUM([Date], 2),
				"StartofMonth",EOMONTH([Date],-1)+1,
				"EndofMonth",EOMONTH([Date],0))
				```

	annotation PBI_Id = f02d9c2502d149efb9b2351229410340

