	/// Account-months in the snapshot copy for Kenya, from the first to the last installment month of the plan. Denominator of every transition rate (as COUNT(Schedules[accountId]) in PAYG Overview).
	measure transition_base_rows = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()))
		displayFolder: Transitions
		lineageTag: db61230b-56a3-4c6a-92ac-e4dbf0ffe159

	/// Account-months at most 30 days late at both the start and the end of the month.
	measure retention(<30) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late_previous_month] <= 30), KEEPFILTERS(schedule[days_late] <= 30))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: 87b04a31-3a3f-4a45-9d67-abe28454bfc6

	/// Account-months at most 60 days late at the end of the month. As in PAYG Overview, the start of the month is not checked (start lateness was only split into <=30 and >30).
	measure retention(<60) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late] <= 60))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: a3d06535-58c8-45fd-9d7e-9be3e50f26f9

	/// Account-months at most 90 days late at the end of the month. As in PAYG Overview, the start of the month is not checked.
	measure retention(<90) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late] <= 90))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: 019188b4-3066-48ff-a9ec-5ae1dca25b31

	/// Account-months at most 30 days late at the start and 31-60 days late at the end, from the second installment month.
	measure attrition(<30) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late_previous_month] <= 30), KEEPFILTERS(schedule[days_late] > 30), KEEPFILTERS(schedule[days_late] <= 60), KEEPFILTERS(schedule[period] >= 1))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: 5b07aeaa-ffc0-450b-92ce-d9adc90daf74

	/// Account-months 61-90 days late at the end of the month. As in PAYG Overview, the start of the month is not checked.
	measure attrition(<60) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late] > 60), KEEPFILTERS(schedule[days_late] <= 90))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: dba88100-1c5d-4813-adea-c9ad4528b597

	/// Account-months 91-120 days late at the end of the month. As in PAYG Overview, the start of the month is not checked.
	measure attrition(<90) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late] > 90), KEEPFILTERS(schedule[days_late] <= 120))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: 0248e272-5135-405b-b96f-b0a64095d3d1

	/// Account-months more than 30 days late at the start and at most 30 days late at the end, from the third installment month.
	measure reactivation(<30) = CALCULATE(COUNTROWS(schedule), KEEPFILTERS(schedule[source] = "snapshot"), KEEPFILTERS(schedule[company_region] = "kenya"), KEEPFILTERS(schedule[period] >= 0), KEEPFILTERS(schedule[period] < 100000), KEEPFILTERS(schedule[is_within_plan] = TRUE()), KEEPFILTERS(schedule[days_late_previous_month] > 30), KEEPFILTERS(schedule[days_late] <= 30), KEEPFILTERS(schedule[period] >= 2))
		formatString: #,0
		displayFolder: Transitions
		lineageTag: ce89b241-557d-4411-a436-b27ec24dbe37

	/// [retention(<30)] / [transition_base_rows]. Migrated from PAYG Overview with the original definition.
	measure %retention_rate(<30) = DIVIDE([retention(<30)], [transition_base_rows], 0)
