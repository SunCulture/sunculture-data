	measure average_monthly_revenue_user =
			
			//var a=CALCULATE(SUM(schedule[month_paid]),schedule[status_change]="active")
			var b=CALCULATE(COUNT(schedule[account_id]),schedule[status_change]="active")
			var netrepaid=CALCULATE(SUM(schedule[net_cumulative_total_month]),schedule[status_change]="active")
			var netrepaid_prev=CALCULATE(SUM(schedule[netrepaid_previous]),schedule[status_change]="active")
			var r=IF(netrepaid-netrepaid_prev<0,0,netrepaid-netrepaid_prev)
			var c=DIVIDE(r,b)
			RETURN
			c
		lineageTag: 21edfa5e-e42f-4fb7-ad81-198018e0be9f

