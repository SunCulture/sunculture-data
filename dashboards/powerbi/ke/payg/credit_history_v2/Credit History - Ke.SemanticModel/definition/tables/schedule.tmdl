	measure receivables_aging =
			
			var exp_monthly=CALCULATE(SUM(schedule[installment_amount]),FILTER(schedule,schedule[monthly_installment_date]<=schedule[end_date]),FILTER(schedule,schedule[period]>0))
			var m_total=IF(MAX(schedule[monthly_installment_date])<=MAX(schedule[end_date])&&MAX(schedule[period])>0,sum(schedule[installment_amount]),0)
			var exp_cum=CALCULATE(SUM(schedule[expected_payment]))
			var bal_cum=CALCULATE(SUM(schedule[balance]))
			var result = SWITCH(
			    SELECTEDVALUE(analysis_type[index]),
			8,exp_monthly,
			9,exp_cum,
			11,bal_cum,
			13,[amount_paid_actual],
			14,[#clients]
			)
			return
			result
		formatString: #,0
		lineageTag: 171c0823-1aef-4fa6-bc46-2d148a89a46a

		annotation PBI_FormatHint = {"isDecimal":true}

