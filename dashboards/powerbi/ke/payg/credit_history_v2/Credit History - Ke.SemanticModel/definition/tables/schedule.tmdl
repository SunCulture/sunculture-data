	/// Months between this row's installment month and today. Column axis of the retention, attrition and reactivation pages (was Schedules[Months_From_Expected_To_CurrentMonth] in PAYG Overview).
	column months_from_installment_to_current =
			VAR d = schedule[monthly_installment_date]
			RETURN IF(ISBLANK(d) || d > TODAY(), BLANK(), DATEDIFF(d, TODAY(), MONTH))
		lineageTag: 16f05051-253b-49bf-89dc-e05c9b2720a9
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// TRUE for months up to the plan's last installment (end_date). PAYG Overview's Schedules table only had installment months, so the transition measures count these rows only.
	column is_within_plan = NOT ISBLANK(schedule[end_date]) && schedule[monthly_installment_date] <= schedule[end_date]
		lineageTag: 3e199ddf-5dbc-4d08-912c-c14c72739377
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition schedule = m
		mode: import
		source =
				let
				    // ============================================================
				    // 1. Current date and refresh time
				    // ============================================================
				    RefreshTime =
				        DateTimeZone.FixedLocalNow(),
				
				    Today =
				        Date.From(RefreshTime),
				
				    PreviousMonthEnd =
				        Date.EndOfMonth(
				            Date.AddMonths(Today, -1)
				        ),
				
				    // ============================================================
				    // 2. Connect to Power Platform Dataflows
				    // ============================================================
				    Source =
				        PowerPlatform.Dataflows(null),
				
				    Workspaces =
				        Source{[Id = "Workspaces"]}[Data],
				
				    Workspace =
				        Workspaces{
				            [workspaceId = "6b82f3d7-43f9-4345-8122-49f60c0278af"]
				        }[Data],
				
				    // ============================================================
				    // 3. LIVE
				    // ============================================================
				    LiveDataflow =
				        Workspace{
				            [dataflowId = "9f956b30-176a-4be3-8717-9193a789c47a"]
				        }[Data],
				
				    Live =
				        LiveDataflow{
				            [entity = "vw_credit_schedule", version = ""]
				        }[Data],
				
				    LiveRenamed =
				        Table.RenameColumns(
				            Live,
				            {
				                {"account_lifecycle_status", "status_change"},
				                {"expected_amount", "expected_amount_ovw"}
				            },
				            MissingField.Ignore
				        ),
				
				    LiveWithSource =
				        Table.AddColumn(
				            LiveRenamed,
				            "source",
				            each "live",
				            type text
				        ),
				
				    // Keep the exact refresh timestamp
				    LiveWithAsOf =
				        Table.AddColumn(
				            LiveWithSource,
				            "as_of",
				            each RefreshTime,
				            type datetimezone
				        ),
				
				    // New date-only column: remains the same throughout the day
				    LiveWithSnapshotDay =
				        Table.AddColumn(
				            LiveWithAsOf,
				            "snapshot_day",
				            each Today,
				            type date
				        ),
				
				    // ============================================================
				    // 4. SNAPSHOT
				    // ============================================================
				    SnapshotDataflow =
				        Workspace{
				            [dataflowId = "c0688259-1aa8-472a-9bba-18a0a170b110"]
				        }[Data],
				
				    Snapshot =
				        SnapshotDataflow{
				            [entity = "credit_schedule", version = ""]
				        }[Data],
				
				    // ============================================================
				    // 5. Filter snapshot to previous month-end
				    // ============================================================
				    SnapshotFiltered =
				        Table.SelectRows(
				            Snapshot,
				            each
				                [snapshot_date] <> null
				                and Date.From([snapshot_date]) = PreviousMonthEnd
				        ),
				
				    SnapshotRenamed =
				        Table.RenameColumns(
				            SnapshotFiltered,
				            {
				                {"account_lifecycle_status", "status_change"},
				                {"expected_amount", "expected_amount_ovw"}
				            },
				            MissingField.Ignore
				        ),
				
				    SnapshotWithSource =
				        Table.AddColumn(
				            SnapshotRenamed,
				            "source",
				            each "snapshot",
				            type text
				        ),
				
				    // Preserve the historical snapshot date
				    SnapshotWithAsOf =
				        Table.AddColumn(
				            SnapshotWithSource,
				            "as_of",
				            each PreviousMonthEnd,
				            type date
				        ),
				
				    // Date-only column for consistent slicer selection
				    SnapshotWithSnapshotDay =
				        Table.AddColumn(
				            SnapshotWithAsOf,
				            "snapshot_day",
				            each PreviousMonthEnd,
				            type date
				        ),
				
				    // ============================================================
				    // 6. Append Live + Snapshot
				    // ============================================================
				    Combined =
				        Table.Combine(
				            {
				                LiveWithSnapshotDay,
				                SnapshotWithSnapshotDay
				            }
				        ),
				
				    // ============================================================
				    // 7. Add Refresh Time
				    // ============================================================
				    AddedRefreshTime =
				        Table.AddColumn(
				            Combined,
				            "refresh_time",
				            each RefreshTime,
				            type datetimezone
				        ),
				
				    // ============================================================
				    // 8. Add Snapshot Selection
				    // ============================================================
				    AddedSnapshotSelection =
				        Table.AddColumn(
				            AddedRefreshTime,
				            "snapshot_selection",
				            each
				                if [source] = "live" then
				                    "Latest (Live)"
				                else
				                    "Previous Month-End",
				            type text
				        ),
				
				    // ============================================================
				    // 9. Set final data types
				    // ============================================================
				    #"Changed Type" =
				        Table.TransformColumnTypes(
				            AddedSnapshotSelection,
				            {
				                {"monthly_installment_date", type date},
				                {"installment_date", type date},
				                {"snapshot_day", type date}
				            }
				        )
				
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

