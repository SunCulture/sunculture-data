	column index_month =
			
			var ranx =
			RANKX(
			schedule,schedule[month_year_no],,ASC,Dense
			)
			return
			ranx
		lineageTag: 9fa645a8-b44b-4eb0-a3f1-dd6dd3884eed
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column month_year_no = FORMAT(schedule[monthly_installment_date],"yyyymm")
		lineageTag: da0f261d-dd43-4a99-be0f-e365f9bd5a63
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column month_installment_paid =
			
			//var a11=CALCULATE(MAX(payments[cum_net_amount]),FILTER(ALL(payments),payments[account_id]=schedule[account_id]))
			//var a1=SWITCH(TRUE(),
			//a11>=schedule[expected_payment],schedule[installment_amount],
			//schedule[net_cumulative_total_month]>=schedule[expected_payment],schedule[installment_amount],
			//schedule[installment_amount]-(schedule[expected_payment]-schedule[net_cumulative_total_month]))
			
			var a2= SWITCH(TRUE(),
			schedule[period]=0||schedule[monthly_installment_date]>schedule[end_date],0,
			schedule[end_month]>=EOMONTH(TODAY(),0),schedule[month_installment_paid2],
			schedule[total_amount]-schedule[downpayment_amount]>=schedule[expected_payment],schedule[installment_amount],
			schedule[installment_amount]-(schedule[expected_payment]-(schedule[total_amount]-schedule[downpayment_amount]))<0,0,
			schedule[installment_amount]-(schedule[expected_payment]-(schedule[total_amount]-schedule[downpayment_amount])))
			return
			a2
		lineageTag: 59a865b6-5ae7-4adc-883b-7533804ca30b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column actual_amount_paid = IF(schedule[period]<=0,0,schedule[balance_previous]-schedule[balance])
		formatString: #,0
		lineageTag: 9fb6af24-45b5-4db6-9571-41d455dc98ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column %collection_rate =
			
			var r=DIVIDE(schedule[cumulative_total_month],schedule[expected_payment],0)*100
			var t=ROUND(r,2)
			VAR f=IF(t<50,"<50%",
			IF(t>=50&&t<69,"50-68%",
			IF(t>=69&&t<=85,"69%-85%",
			IF(t>85,">85%",BLANK()))))
			return
			f
		lineageTag: ad2c7b3d-d37d-455e-a489-9d477346c8c5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column first_status_change =
			
			VAR CurrentSnapshot =
			    CALCULATE(
			        MAX(schedule[as_of]),
			        ALL(schedule)
			    )
			
			VAR a =
			    CALCULATE(
			        MIN(schedule[monthly_installment_date]),
			        FILTER(
			            ALLEXCEPT(schedule, schedule[account_id]),
			            schedule[as_of] = CurrentSnapshot
			                && schedule[status_change] = "Inactive"
			        )
			    )
			
			VAR b =
			    IF(
			        schedule[as_of] = CurrentSnapshot
			            && schedule[monthly_installment_date] = a,
			        1,
			        0
			    )
			
			RETURN
			    b
		formatString: #,0
		lineageTag: 3644af22-f1fa-4050-80b1-e35ea3157301
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column exited_clients = IF(schedule[first_status_change]=1,"Yes","No")
		lineageTag: 92090ecb-ae12-492c-bf69-c64cf784796b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column balance_previous_active = ```
			
			IF(
			    schedule[status_change] = "active",
			    schedule[balance_previous],
			    BLANK()
			)
			
			```
		lineageTag: 3491c81e-5c02-4c41-891f-69d1cc500e70
		summarizeBy: sum

