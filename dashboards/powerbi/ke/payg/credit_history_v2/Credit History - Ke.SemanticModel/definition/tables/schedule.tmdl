	column actual_payment_allocated =
			
			VAR ThisAccount =
			    schedule[account_id]
			
			VAR ThisDate =
			    schedule[monthly_installment_date]
			
			-- Total actual payment for this client
			VAR TotalActualPaid =
			    CALCULATE(
			        SUM(schedule[actual_amount_paid]),
			        FILTER(
			            ALL(schedule),
			            schedule[account_id] = ThisAccount
			        )
			    )
			
			-- Expected amount before this schedule
			VAR ExpectedBefore =
			    CALCULATE(
			        SUM(schedule[installment_amount]),
			        FILTER(
			            ALL(schedule),
			            schedule[account_id] = ThisAccount
			                && schedule[period] > 0
			                && schedule[monthly_installment_date] < ThisDate
			                && schedule[monthly_installment_date] <= schedule[end_date]
			        )
			    )
			
			-- Expected amount for this schedule
			VAR ExpectedThisSchedule =
			    IF(
			        schedule[period] > 0
			            && schedule[monthly_installment_date] <= schedule[end_date],
			        schedule[installment_amount],
			        0
			    )
			
			-- Payment remaining after previous schedules
			VAR RemainingPayment =
			    TotalActualPaid - ExpectedBefore
			
			RETURN
			    MAX(
			        0,
			        MIN(
			            ExpectedThisSchedule,
			            RemainingPayment
			        )
			    )
		formatString: #,0
		lineageTag: 233a903b-fd27-4c57-9a33-c5ccd8546daf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

