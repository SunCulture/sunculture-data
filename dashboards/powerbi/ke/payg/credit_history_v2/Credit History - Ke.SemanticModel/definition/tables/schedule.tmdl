	measure #new_clients =
			
			var last_m=CALCULATE(
			TOTALMTD(COUNT(schedule[account_id]),schedule[end_month]),PARALLELPERIOD(schedule[end_month],-1,MONTH))
			var prev=CALCULATE (
			    DISTINCTCOUNT(schedule[account_id]),
			    FILTER ( ALLSELECTED( schedule ),  schedule[index_month]= MAX ( schedule[index_month] )-1 )
			)
			var r=[#clients]-prev
			var t=CALCULATE(COUNT(schedule[account_id]),schedule[period]=0)
			return
			t
		formatString: #,0
		lineageTag: 75c4c784-ba0e-4cb3-954a-345f034da19b

