	measure %arrears_growth =
			
			VAR a0 =
			    CALCULATE(
			        SUM(schedule[arrears]),
			        schedule[period] >= 0
			    )
			VAR a1 =
			    CALCULATE(
			        SUM(schedule[arrears_previous]),
			        schedule[period] >= 0
			    )
			VAR result =
			    DIVIDE(a0 - a1, a1, 0)
			RETURN
			    result
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3c1bf429-6dc0-4816-8c9a-6997aafb41cf

	measure %collection_growth =
			
			var prev=CALCULATE (
			    SUM(schedule[month_installment_paid2]),
			    FILTER ( ALLSELECTED(schedule ),  schedule[index_month]= MAX ( schedule[index_month] )-1 )
			)
			var cur=CALCULATE(SUM(schedule[month_installment_paid2]))
			return
			DIVIDE(cur-prev,prev,0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ff02a29a-27c9-4468-af01-de974a684be7

	measure %credit_growth =
			
			VAR prev =
			    CALCULATE(
			        SUM(schedule[credit_sale]),
			        FILTER(
			            ALLSELECTED(schedule),
			            schedule[index_month] = MAX(schedule[index_month]) - 1
			                && schedule[period] >= 0
			        )
			    )
			VAR cur =
			    CALCULATE(
			        SUM(schedule[credit_sale]),
			        schedule[period] >= 0
			    )
			RETURN
			    DIVIDE(cur - prev, prev, 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 41eac8c1-5739-41bf-bb77-6c4dd0542ba5

