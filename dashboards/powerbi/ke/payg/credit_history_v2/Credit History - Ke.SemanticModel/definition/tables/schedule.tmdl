	measure 'Weighted Average Sequence Days' =
			
			VAR Accounts =
			    SUMMARIZE(
			        'schedule',
			        'schedule'[account_id],
			        "Sequence", MAX('schedule'[total_number_payments])
			    )
			RETURN
			    SUMX(
			        Accounts,
			        DIVIDE(
			            1,
			            COUNTROWS(Accounts)
			        ) * [Sequence] * 30
			    )
		formatString: #,0
		lineageTag: 68ed0172-0833-4d7f-b7f4-da3b66dc2059

		annotation PBI_FormatHint = {"isDecimal":true}

