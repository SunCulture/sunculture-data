	measure average_credit_period =
			
			var a=CALCULATE(SUM(schedule[total_number_payments]),schedule[status_change]="active")
			var b=CALCULATE(COUNT(schedule[account_id]),schedule[status_change]="active")
			var c=DIVIDE(a,b)
			RETURN
			c
