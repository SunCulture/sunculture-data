	column AccountRef = ```
			
			VAR NID = 'Sundesk Tickets'[nationalid]
			VAR ViaNationalId =
			    IF (
			        LEN ( NID ) > 3,
			        CALCULATE ( MAX ( points[accountRef] ), points[identification_number] = NID )
			    )
			VAR ViaTicketNumber =
			    MAXX ( RELATEDTABLE ( vw_jsf ), RELATED ( points[accountRef] ) )
			RETURN
			    COALESCE ( ViaNationalId, ViaTicketNumber )
			
			```
		lineageTag: c9b6bd06-956b-4c15-8672-72ae56cdd0aa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column deviceid = ```
			
			VAR NID = 'Sundesk Tickets'[nationalid]
			VAR ViaNationalId =
			    IF (
			        LEN ( NID ) > 3,
			        CALCULATE ( MAX ( points[deviceId] ), points[identification_number] = NID )
			    )
			VAR ViaTicketNumber =
			    MAXX ( RELATEDTABLE ( vw_jsf ), RELATED ( points[deviceId] ) )
			RETURN
			    COALESCE ( ViaNationalId, ViaTicketNumber )
			
			```
