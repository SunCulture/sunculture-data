				    #"Kept Columns" = Table.SelectColumns(#"Renamed Columns", {"accommodation_cost", "account_id", "assignment_date", "casual_pay", "comment", "costings", "customer_preferred_schedule_type", "engineer_id", "engineer_recommendation", "installation_id", "jsf_completed_date", "jsf_date", "jsf_engineer2", "jsf_id", "jsf_status", "jsf_type", "meal_costings", "outcome_reason", "rm_2_device_id", "ticket_number", "transport_costs"}, MissingField.Ignore)
