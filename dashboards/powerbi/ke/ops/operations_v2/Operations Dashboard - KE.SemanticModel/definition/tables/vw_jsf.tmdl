	column 'Days Taken' =
			
			DATEDIFF(
			    vw_jsf[assignment_date],
			    vw_jsf[jsf_date],
			    DAY
			)
		formatString: 0
		lineageTag: d8853767-8f93-42dc-a119-a5b065611623
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SLA Status' =
			
			SWITCH(
			    TRUE(),
			
			    vw_jsf[schedule_type] = "INSTALLATION"
			        && vw_jsf[Days Taken] <= 5,
			        "Within SLA",
			
			    vw_jsf[schedule_type] = "AFTERSALE"
			        && vw_jsf[Days Taken] <= 2,
			        "Within SLA",
			
			    "Out of SLA"
			)
		lineageTag: c839ef12-93d6-4623-8cf1-924db3268106
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Jsf Account Type' =
			
			LOOKUPVALUE(
			    'points'[accountType],
			    'points'[account_id],
			    'vw_jsf'[account_id]
			)
		lineageTag: 9037acf5-f656-4e43-9f10-90589ca5deae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Supervisor Name' =
			
			VAR EngineerID = vw_jsf[engineer_id]
			
			VAR EngineerSupervisorID =
			    CALCULATE(
			        MAX(vw_employees[employee_supervisor_id]),
			        FILTER(
			            ALL(vw_employees),
			            vw_employees[employee_amt_id] = EngineerID
			        )
			    )
			
			VAR EngineerSupervisorName =
			    CALCULATE(
			        MAX(vw_employees[supervisor_name]),
			        FILTER(
			            ALL(vw_employees),
			            vw_employees[employee_amt_id] = EngineerID
			        )
			    )
			
			VAR SupervisorOfSupervisorName =
			    CALCULATE(
			        MAX(vw_employees[supervisor_name]),
			        FILTER(
			            ALL(vw_employees),
			            vw_employees[employee_amt_id] = EngineerSupervisorID
			        )
			    )
			
			RETURN
			    IF(
			        EngineerSupervisorID IN {780, 798},
			        EngineerSupervisorName,
			        SupervisorOfSupervisorName
			    )
		lineageTag: 055db497-5260-4719-a3bf-e507703604b6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// jsf_date truncated to midnight so it can join to a date table (raw jsf_date carries a time component).
	column 'JSF Date (Day)' = VAR D = vw_jsf[jsf_date] RETURN IF ( ISBLANK ( D ), BLANK (), DATE ( YEAR ( D ), MONTH ( D ), DAY ( D ) ) )
		dataType: dateTime
		formatString: yyyy-mm-dd
		displayFolder: Installation Outcome
		lineageTag: 6ce03c4a-ec13-4dde-bc9a-7fb17231b39b

	/// Installed / Not Installed for COMPLETED installation JSFs in Kenya, from the engineer recommendation. Blank for every other JSF (aftersale, repossession, survey, in-progress, other countries).
	column 'Install Outcome' =
			VAR R = vw_jsf[engineer_recommendation]
			RETURN
			    IF (
			        vw_jsf[jsf_type] = "INSTALLATION"
			            && vw_jsf[jsf_status] = "COMPLETED"
			            && vw_jsf[Company Region] = "kenya"
			            && R IN { "Installed", "Not Installed" },
			        R,
			        BLANK ()
			    )
		displayFolder: Installation Outcome
		lineageTag: 41648bfe-427f-42b7-8578-803b4d0371e2

	/// Cleaned outcome reason for Not Installed visits (normalises case/typos such as AGGED_FOR_REPOSSESSIO). Blank when the unit was installed.
	column 'Install Failure Reason' =
			
			VAR R = UPPER ( SUBSTITUTE ( TRIM ( vw_jsf[outcome_reason] ), " ", "_" ) )
			RETURN
			    IF (
			        vw_jsf[Install Outcome] <> "Not Installed",
			        BLANK (),
			        SWITCH (
			            TRUE (),
			            CONTAINSSTRING ( R, "PRODUCT_FAIL" ), "Product Fault",
			            CONTAINSSTRING ( R, "PUMP_FAULT" ), "Pump Fault",
			            CONTAINSSTRING ( R, "PUMP_SWAP" ), "Pump Swap",
			            CONTAINSSTRING ( R, "PANEL_SWAP" ), "Panel Swap",
			            CONTAINSSTRING ( R, "KIT_CHANGE" ), "Kit Change",
			            CONTAINSSTRING ( R, "UNSUITABLE" ), "Unsuitable Product",
			            CONTAINSSTRING ( R, "CLIENT_NOT_VISITED" ), "Client Not Visited",
			            CONTAINSSTRING ( R, "NOT_READY" ), "Client Not Ready",
			            CONTAINSSTRING ( R, "LOW_WATER" ), "Low Water Levels",
			            CONTAINSSTRING ( R, "NO_WATER" ), "No Water Source",
			            CONTAINSSTRING ( R, "REPOSSESS" ), "Tagged For Repossession",
			            CONTAINSSTRING ( R, "ON_HOLD" ), "On Hold",
			            CONTAINSSTRING ( R, "SCHEDULE" ), "Rescheduled"
			        )
			    )
		displayFolder: Installation Outcome
		lineageTag: 3922aff8-55d5-4051-9f39-bf578582ec65
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Who owns the failed visit: Product / Pump Fault (the installation failure KPI), Kit & Product Mismatch, Customer & Site, Commercial, Scheduling & Other.
	column 'Install Failure Category' =
			
			VAR F = vw_jsf[Install Failure Reason]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( F ) || F = "", BLANK (),
			        F IN { "Product Fault", "Pump Fault" }, "Product Fault",
			        F IN { "Pump Swap", "Panel Swap" }, "Pump/Panel Swap",
			        F = "Kit Change", "Kit Change",
			        F = "Unsuitable Product", "Unsuitable Product",
			        F IN { "Client Not Visited", "Client Not Ready", "Low Water Levels", "No Water Source" }, "Customer & Site",
			        F = "Tagged For Repossession", "Repossession",
			        F = "On Hold", "On Hold",
			        "Other"
			    )
		displayFolder: Installation Outcome
		lineageTag: b7d5a05a-07ba-4344-b3af-8a9fc1ec549a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Product on the account this JSF belongs to (points[product]).
	column 'Install Product' = RELATED ( points[product] )
		displayFolder: Installation Outcome
		lineageTag: f4ebb7df-0b1f-4922-ace5-424f9cf1c9ca

	/// Refurb / Non-Refurb from the account product name (contains 'refurb', or ends in ' - R' / '-R'). Same rule as the ticket and unit tables.
	column 'Install Build Type' =
			VAR P = LOWER ( TRIM ( RELATED ( points[product] ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( P ) || P = "", "Unlinked",
			        CONTAINSSTRING ( P, "refurb" ) || RIGHT ( P, 4 ) = " - r" || RIGHT ( P, 2 ) = "-r" || CONTAINSSTRING ( P, "-r " ), "Refurb",
			        "Non-Refurb"
			    )
		displayFolder: Installation Outcome
		lineageTag: 665742ed-d187-458d-9b14-325d934fccff

	column 'Engineer Role' = ```
			
			VAR EngineerID = vw_jsf[engineer_id]
