	column job_status_form_id =
			
			
			VAR LatestRecord =
			    TOPN(
			        1,
			        FILTER(
			            ALL(vw_jsf),
			            vw_jsf[account_id] = points[account_id] &&
			            DATEVALUE(vw_jsf[jsf_date]) = DATEVALUE(points[jsf_date])
			        ),
			        vw_jsf[jsf_completed_date], DESC
			    )
			
			RETURN
			    MAXX(LatestRecord, vw_jsf[jsf_id])
		lineageTag: 5a46fd29-9fc7-464c-8d93-c64a7f162be5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

