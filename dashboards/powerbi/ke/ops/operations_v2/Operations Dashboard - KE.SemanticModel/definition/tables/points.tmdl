	/// Installed when the account has a completed INSTALLATION JSF with recommendation Installed (same rule as the failure rates).
	column 'Install Status' = IF ( COUNTROWS ( FILTER ( RELATEDTABLE ( vw_jsf ), vw_jsf[Install Outcome] = "Installed" ) ) > 0, "Installed", BLANK () )
