	column customer_preferred_engineer =
			
			var v1=CALCULATE(MAX(vw_jsf[Assignment_Engineer]),FILTER(ALL(vw_jsf),DATEVALUE(vw_jsf[assignment_date])=DATEVALUE(points[Assign_date])&&vw_jsf[account_id]=points[account_id]))
			
			RETURN
			V1
		lineageTag: 6b1dd357-0bb9-415c-bc62-1214d0e6ccd2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

