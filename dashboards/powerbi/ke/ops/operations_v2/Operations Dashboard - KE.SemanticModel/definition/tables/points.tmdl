	column 'Days Untill Expiry' =
			SWITCH(TRUE(),
			points[Days to warranty expiry]>=0&& points[Days to warranty expiry]<=10,"10",
			points[Days to warranty expiry]>10&&points[Days to warranty expiry]<=30,"30",
			points[Days to warranty expiry]>30&&points[Days to warranty expiry]<=60,"60",
			points[Days to warranty expiry]>60&&points[Days to warranty expiry]<=90,"90",
			points[Days to warranty expiry]>90&&points[Days to warranty expiry]<=120,"120",
			points[Days to warranty expiry]>120&&points[Days to warranty expiry]<=180,"180",
			points[Days to warranty expiry]>180&&points[Days to warranty expiry]<=270,"270",
			points[Days to warranty expiry]>270&&points[Days to warranty expiry]<=360,"360",
			">360")
		lineageTag: 2bfea164-a614-4cc9-ad11-086a1dcf671d
		summarizeBy: none
		sortByColumn: 'days untill expiry seq'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Days after Expiry' =
			SWITCH(TRUE(),
			points[Days to warranty expiry]>=-30&&points[Days to warranty expiry]<0,"30",
			points[Days to warranty expiry]>=-60&&points[Days to warranty expiry]<-30,"60",
			points[Days to warranty expiry]>=-90&&points[Days to warranty expiry]<-60,"90",
			points[Days to warranty expiry]>=-180&&points[Days to warranty expiry]<-90,"180",
			points[Days to warranty expiry]>=-365&&points[Days to warranty expiry]<-180,"1 year",
			points[Days to warranty expiry]>=-730&&points[Days to warranty expiry]<-365,"2 years",
			points[Days to warranty expiry]>=-1095&&points[Days to warranty expiry]<-730,"3 years",
			points[Days to warranty expiry]<-1095,"4 years and above",
			"4 years and above")
		lineageTag: aab4e476-c8a8-44dc-8e9f-64bbc5c29e05
		summarizeBy: none
		sortByColumn: 'Days after Expiry seq'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

