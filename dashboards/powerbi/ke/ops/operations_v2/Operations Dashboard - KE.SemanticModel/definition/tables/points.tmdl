	column totalprice =
			
			var sa=CALCULATE(SUM(points[downpayment_amount])+SUM(points[installment_amount])*SUM(points[total_number_payments]))
			return
			sa
		formatString: #,0
		lineageTag: b33060a3-e167-488f-a7e4-8dff302685ca
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column repossession_date = CALCULATE(MAX(status_change[status_date]),FILTER(ALL(status_change),status_change[account_id]=points[account_id]&&status_change[current_status]="repossession"))
		formatString: dd/mm/yyyy
		lineageTag: 3d82c847-8758-4da9-98b9-07fe8fd67f03
		summarizeBy: none

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column installation_date =
			
			var product = points[product]
			var dispatch_date=points[dispatch_date]
			var inst_date=points[installment_date]
			VAR sale_date=points[sale_date]
			var jsf_date2 = CALCULATE(MIN(vw_jsf[jsf_date]))
			var jsf_date=IF(ISBLANK(inst_date)&&ISBLANK(dispatch_date)&&ISBLANK(jsf_date2),sale_date,
			IF(ISBLANK(inst_date)&&ISBLANK(jsf_date2),dispatch_date,
			IF(ISBLANK(jsf_date2),inst_date,jsf_date2)))
			return
			DATEVALUE(jsf_date)
		formatString: General Date
		lineageTag: de9ac2c5-969a-44ea-a013-07c0101e5b09
		summarizeBy: none

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column units =
			
			
			var r=IF(points[productQty]<1||ISBLANK(points[productQty]),1,points[productQty])
			return
			r
		formatString: #,0
		lineageTag: e0672b9d-6ce7-4f41-9cd1-c7d38d7f2610
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column warranty_status = ```
			
			var a=points[warranty_expiry_date]
			var b=IF((points[status] in {"full deposit","partial deposit","repossession", "write off","on hold","pending repossession on","rejected","partial refunded","refunded","no deposit"}),BLANK(),IF(ISBLANK(a), BLANK(),IF( a>TODAY(),"Under Warranty","Out of Warranty")))
			return  
			b
			```
		lineageTag: 312866a7-aded-4ca2-9376-eea4cddfa904
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

