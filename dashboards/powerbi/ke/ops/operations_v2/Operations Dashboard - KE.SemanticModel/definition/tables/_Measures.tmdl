	measure 'JSFs Syncing Rate' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( vw_jsf[installation_id] ), KEEPFILTERS ( vw_jsf[jsf_status] = "COMPLETED" ) ), DISTINCTCOUNT ( vw_jsf[installation_id] ) )
