		lineageTag: 14eda750-135e-4179-8184-e4d7c9f3e2fc

	measure total_costs_vw_jsf = CALCULATE(SUM(vw_jsf[meal_costings]))+CALCULATE(SUM(vw_jsf[accommodation_cost]))+CALCULATE(SUM(vw_jsf[casual_pay]))+CALCULATE(SUM(vw_jsf[transport_costs]))+CALCULATE(SUM(vw_jsf[costings]))
		formatString: #,0
