/// All report measures, in display folders by page area. Aftersales holds the SunDesk + JSF rebuild of the Salesforce aftersales logic.
table _Measures
	lineageTag: ee964bca-0f3d-4f89-93ff-447e6118581e

	/// Completed installation JSFs (Kenya) where the engineer recommendation is Installed. Dated by JSF date.
	measure 'Installs Completed' = CALCULATE ( COUNTROWS ( vw_jsf ), KEEPFILTERS ( vw_jsf[Install Outcome] = "Installed" ), USERELATIONSHIP ( vw_jsf[JSF Date (Day)], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\1 Installations
		lineageTag: 49e6ca01-5e98-4f59-8f55-91097466b356

	/// Completed installation JSFs where the engineer recommendation is Not Installed, for any reason.
	measure 'Not Installed Visits' = CALCULATE ( COUNTROWS ( vw_jsf ), KEEPFILTERS ( vw_jsf[Install Outcome] = "Not Installed" ), USERELATIONSHIP ( vw_jsf[JSF Date (Day)], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\1 Installations
		lineageTag: 705aefde-5d5d-4c56-b440-588295c0a4cd

	/// All completed installation visits with an outcome (Installed + Not Installed). Denominator for the installation rates. Same as #jsf_fma in the Salesforce report.
	measure 'Installation Visits' = CALCULATE ( COUNTROWS ( vw_jsf ), KEEPFILTERS ( vw_jsf[Install Outcome] IN { "Installed", "Not Installed" } ), USERELATIONSHIP ( vw_jsf[JSF Date (Day)], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\1 Installations
		lineageTag: 46008dba-17a3-4f2e-85ef-be8d751a22c9

	/// Not Installed visits whose outcome reason is Product Failure or a Pump swap - the unit could not be installed because the product itself was faulty. This is the installation failure KPI.
	measure 'Install Failures (Product/Pump)' =
			
			CALCULATE (
			    COUNTROWS ( vw_jsf ),
			    KEEPFILTERS ( vw_jsf[Install Failure Category] IN { "Product Fault"} ),
			    USERELATIONSHIP ( vw_jsf[JSF Date (Day)], 'AS Calendar'[Date] )
			)
		formatString: #,0
		displayFolder: Aftersales\1 Installations
		lineageTag: e083466d-9e5d-499d-b107-a6248470d0b5

	/// Product/Pump-fault installation failures as a share of all installation visits. Headline installation-failure KPI.
	measure 'Installation Failure Rate' = DIVIDE ( [Install Failures (Product/Pump)], [Installation Visits] )
		formatString: 0.00%
		displayFolder: Aftersales\1 Installations
		lineageTag: bb2e759d-1750-4bdd-9bba-25d61d1ef4d9

	/// Share of installation visits that ended Not Installed for any reason (Salesforce %jsf_not_installed).
	measure 'Not Installed Rate' = DIVIDE ( [Not Installed Visits], [Installation Visits] )
		formatString: 0.0%
		displayFolder: Aftersales\1 Installations
		lineageTag: 2e883865-7d40-4528-a37c-8cb700735c7e

	/// Share of all Not Installed visits in the current selection (use with the failure reason / category axis).
	measure 'Share of Not Installed' = DIVIDE ( [Not Installed Visits], CALCULATE ( [Not Installed Visits], REMOVEFILTERS ( vw_jsf[Install Failure Reason] ), REMOVEFILTERS ( vw_jsf[Install Failure Category] ) ) )
		formatString: 0.0%
		displayFolder: Aftersales\1 Installations
		lineageTag: 1a648b8e-5f30-49d6-9063-d94963ae11f1

	/// Installation visits per unit actually installed. 1.00 = every unit installed on the first trip.
	measure 'Visits per Install' = DIVIDE ( [Installation Visits], [Installs Completed] )
		formatString: 0.00
		displayFolder: Aftersales\1 Installations
		lineageTag: 56f98d90-0606-4b45-8620-e06ee01cd418

	/// Confirmed product failures: tickets Testing & Repairs completed with a recorded cause other than No Fault Found. Dated by ticket creation date.
	measure 'Fault Tickets' =
			CALCULATE ( DISTINCTCOUNT ( 'Sundesk Tickets'[id] ),
			    KEEPFILTERS ( 'Sundesk Tickets'[Confirmed Failure] = "Confirmed Failure" ),
			    USERELATIONSHIP ( 'Sundesk Tickets'[created_at], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: b348895a-dc87-4208-a8b5-0981ce039e91

	/// Fault tickets tied to an installed unit, so they carry product, build type and days-to-failure.
	measure 'Fault Tickets (Linked)' = CALCULATE ( [Fault Tickets], KEEPFILTERS ( NOT ISBLANK ( 'Sundesk Tickets'[Linked Account] ) ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: 4cce99ec-5ffc-45a8-942e-5e95abac03cf

	/// Distinct installed units with at least one confirmed failure in the period.
	measure 'Units With Faults' =
			CALCULATE ( DISTINCTCOUNT ( 'Sundesk Tickets'[Linked Account] ),
			    KEEPFILTERS ( 'Sundesk Tickets'[Confirmed Failure] = "Confirmed Failure" ),
			    KEEPFILTERS ( NOT ISBLANK ( 'Sundesk Tickets'[Linked Account] ) ),
			    USERELATIONSHIP ( 'Sundesk Tickets'[created_at], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: fffa7304-f50a-4e1f-bcf7-ac7293755db8

	/// Share of fault tickets in the current selection, ignoring component / failure-mode / cause breakdowns (use on those axes).
	measure 'Share of Fault Tickets' = DIVIDE ( [Fault Tickets], CALCULATE ( [Fault Tickets], REMOVEFILTERS ( 'Sundesk Tickets'[Component Group] ), REMOVEFILTERS ( 'Sundesk Tickets'[Component] ), REMOVEFILTERS ( 'Sundesk Tickets'[Failure Mode] ), REMOVEFILTERS ( 'Sundesk Tickets'[Failure Cause] ), REMOVEFILTERS ( 'Sundesk Tickets'[Days to Fail Band] ) ) )
		formatString: 0.0%
		displayFolder: Aftersales\2 Product Failures
		lineageTag: adecbfe7-6dd4-4c33-aac6-e5bdbe36a795

	/// Median age of the unit, in days since install, when the confirmed failure was raised.
	measure 'Median Days to Failure' =
			CALCULATE (
			    MEDIANX ( FILTER ( 'Sundesk Tickets', NOT ISBLANK ( 'Sundesk Tickets'[Days to Failure] ) ),
			              'Sundesk Tickets'[Days to Failure] ),
			    KEEPFILTERS ( 'Sundesk Tickets'[Confirmed Failure] = "Confirmed Failure" ),
			    USERELATIONSHIP ( 'Sundesk Tickets'[created_at], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: f2a9600b-5922-48e8-bb27-d04828e7db5a

	/// Fault tickets raised within 30 days of installation - points at quality at dispatch or installation workmanship.
	measure 'Early Failures (0-30 Days)' = CALCULATE ( [Fault Tickets], KEEPFILTERS ( 'Sundesk Tickets'[Days to Fail Band] = "0-30 Days" ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: 5369567b-afd9-4648-8ae5-43f8d1579cdf

	/// Share of linked fault tickets raised in the unit's first 30 days.
	measure 'Early Failure %' = DIVIDE ( [Early Failures (0-30 Days)], [Fault Tickets (Linked)] )
		formatString: 0.0%
		displayFolder: Aftersales\2 Product Failures
		lineageTag: d79b24df-71d9-4fe6-9b8a-d537a368e6ae

	/// Fault tickets in the current and previous two calendar months (Salesforce '3 Months Product Failure Comparison').
	measure 'Fault Tickets (Last 3 Months)' = VAR StartM = EOMONTH ( TODAY (), -3 ) + 1 RETURN CALCULATE ( [Fault Tickets], KEEPFILTERS ( 'AS Calendar'[Date] >= StartM ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: f6b93cf5-cef1-4bf9-8c28-20522d251d15

	/// Installed Kenyan units (excl. refunded/rejected), dated by install (JSF) date. Salesforce 'installations'.
	measure 'Units Installed' = CALCULATE ( SUM ( 'Unit Failures'[Units] ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: a7a34c66-3a0e-48e9-aaaf-e3550d2ac51f

	/// Units with at least one CONFIRMED failure - Testing & Repairs completed the ticket and recorded a cause other than No Fault Found. Dated by install date, so a date slicer picks the install cohort.
	measure 'Units Failed' =
			CALCULATE ( SUM ( 'Unit Failures'[Units] ),
			    KEEPFILTERS ( 'Unit Failures'[Has Faulted] = "Faulted" ),
			    USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 0de25b3d-f6d6-437e-829c-add240a24c27

	/// Observation-window rate: of the units in the field, the share with a confirmed bench failure during the diagnosis window. Not a lifetime rate - it covers only the months Testing & Repairs has been diagnosing, so always read it alongside the Observation Window label.
	measure 'Product Failure Rate' = VAR U = [Units Installed] RETURN IF ( ISBLANK ( U ) || U = 0, BLANK (), DIVIDE ( COALESCE ( [Units Failed], 0 ), U ) )
		formatString: 0.0%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: effe87d7-338b-4543-b7fa-baf228afae1d

	/// Installed base to the end of the period (today for the current month).
	measure 'Units Installed Cum' = VAR DateS = MIN ( MAX ( 'AS Calendar'[Date] ), TODAY () ) RETURN CALCULATE ( SUM ( 'Unit Failures'[Units] ), 'AS Calendar'[Date] <= DateS, REMOVEFILTERS ( 'AS Calendar' ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 2bef2be4-0f24-4f71-b4e2-ab9a1d1158bb

	/// Units in the installed base at period end that had already had their first fault by that date (true as-at logic).
	measure 'Units Failed Cum' = VAR DateS = MIN ( MAX ( 'AS Calendar'[Date] ), TODAY () ) RETURN CALCULATE ( SUM ( 'Unit Failures'[Units] ), 'AS Calendar'[Date] <= DateS, REMOVEFILTERS ( 'AS Calendar' ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ), KEEPFILTERS ( FILTER ( ALL ( 'Unit Failures'[First Fault Date] ), NOT ISBLANK ( 'Unit Failures'[First Fault Date] ) && 'Unit Failures'[First Fault Date] <= DateS ) ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 62e0c06e-8bcf-411a-8256-80c11380d764

	/// Of every unit installed up to this point, the share that had failed by this point (Salesforce %_failure_rate_fail_category_cum, unit-based). Rising = fleet degrading; flattening = fleet maturing healthily.
	measure 'Cumulative Failure Rate' = VAR R = DIVIDE ( [Units Failed Cum], [Units Installed Cum] ) RETURN IF ( ISBLANK ( R ), BLANK (), MIN ( R, 1 ) )
		formatString: 0.0%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: c0b3c7dc-5bae-4cf7-8ed5-8abb957371df

	/// Of units installed since bench diagnosis began, and with at least 90 days in the field, the share with a confirmed failure inside their first 90 days. Same exposure window for every product and month - the fairest number for ranking products.
	measure 'Failure Rate (First 90 Days)' =
			VAR WindowStart = [Confirmation Window Start]
			RETURN CALCULATE (
			    VAR Eligible = FILTER ( 'Unit Failures',
			        'Unit Failures'[Days in Field] >= 90 && 'Unit Failures'[Install Date] >= WindowStart )
			    VAR Base = SUMX ( Eligible, 'Unit Failures'[Units] )
			    VAR F = SUMX ( FILTER ( Eligible,
			        NOT ISBLANK ( 'Unit Failures'[Days to First Fault] )
			            && 'Unit Failures'[Days to First Fault] <= 90 ), 'Unit Failures'[Units] )
			    RETURN IF ( ISBLANK ( Base ) || Base = 0, BLANK (), DIVIDE ( COALESCE ( F, 0 ), Base ) ),
			    USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: 0.0%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 0884363b-2231-4af9-ab19-a53db932926d

	/// Months of field exposure accumulated by the selected units (install date to today).
	measure 'Unit Months in Field' = CALCULATE ( SUMX ( 'Unit Failures', 'Unit Failures'[Units] * DIVIDE ( 'Unit Failures'[Days in Field], 30.44 ) ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 84838fe1-0467-4cee-bd89-43eac7a0c6dd

	/// Exposure-adjusted failure intensity: lifetime fault tickets of the selected units per 1,000 months in the field. Use to compare products of different ages.
	measure 'Faults per 1,000 Unit-Months' = DIVIDE ( CALCULATE ( SUM ( 'Unit Failures'[Faults] ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) ) * 1000, [Unit Months in Field] )
		formatString: #,0.0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 4e758f00-9ac9-4745-9185-5787ff3655d0

	/// Median days from install to first fault, for units that have faulted.
	measure 'Median Days to First Fault' = CALCULATE ( MEDIANX ( FILTER ( 'Unit Failures', NOT ISBLANK ( 'Unit Failures'[Days to First Fault] ) ), 'Unit Failures'[Days to First Fault] ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 7c038221-867f-47f8-9db5-cb1755ec282c

	/// Units with a confirmed bench failure on the component / failure mode on the axis, during the observation window.
	measure 'Units Failed (Component)' =
			CALCULATE ( DISTINCTCOUNT ( 'Sundesk Tickets'[Linked Account] ),
			    KEEPFILTERS ( 'Sundesk Tickets'[Confirmed Failure] = "Confirmed Failure" ),
			    KEEPFILTERS ( NOT ISBLANK ( 'Sundesk Tickets'[Linked Account] ) ),
			    USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 8580aedd-80e1-449a-8d7b-d1e53264ec38

	/// Units with a confirmed failure on this component as a share of ALL units in the field during the observation window. Numerator follows the component axis; the denominator stays the whole installed base, so this reads as share of fleet affected, not a per-component reliability rate.
	measure 'Component Failure Rate' = DIVIDE ( [Units Failed (Component)], [Units Installed] )
		formatString: 0.00%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: b7f40514-a1bc-448d-bf52-08787b57ace7

	/// Salesforce failure_rate_fail_category: of units that have failed, the share whose FIRST fault fell in each age band. Use with Unit Failures[First Fault Band] on the axis.
	measure 'Share of Failed Units by First-Fault Age' = DIVIDE ( [Units Failed], CALCULATE ( [Units Failed], REMOVEFILTERS ( 'Unit Failures'[First Fault Band] ), REMOVEFILTERS ( 'Unit Failures'[First Fault Order] ) ) )
		formatString: 0.0%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: b67d692c-0002-4739-95cb-feebf831c954

	/// Survival view on the Fail Age Bands axis: of units installed since bench diagnosis began and old enough to have reached that age, the share with a confirmed failure by then.
	measure 'Cumulative % Failed by Age' =
			VAR M = MAX ( 'Fail Age Bands'[Max Days] )
			VAR WindowStart = [Confirmation Window Start]
			RETURN CALCULATE (
			    VAR Eligible = FILTER ( 'Unit Failures',
			        'Unit Failures'[Days in Field] >= M && 'Unit Failures'[Install Date] >= WindowStart )
			    VAR Base = SUMX ( Eligible, 'Unit Failures'[Units] )
			    VAR F = SUMX ( FILTER ( Eligible,
			        NOT ISBLANK ( 'Unit Failures'[Days to First Fault] )
			            && 'Unit Failures'[Days to First Fault] <= M ), 'Unit Failures'[Units] )
			    RETURN IF ( ISBLANK ( Base ) || Base = 0, BLANK (), DIVIDE ( COALESCE ( F, 0 ), Base ) ),
			    USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: 0.0%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 36e671b5-4e4c-42e0-9dcb-156410133055

	/// Product Failure Rate for refurbished units.
	measure 'Refurb Failure Rate' = CALCULATE ( [Product Failure Rate], KEEPFILTERS ( 'Unit Failures'[Build Type] = "Refurb" ) )
		formatString: 0.0%
		displayFolder: Aftersales\4 Refurb vs Non-Refurb
		lineageTag: 4e027a12-abe4-4ee6-b99a-40c4ec6b9211

	/// Product Failure Rate for new (non-refurbished) units.
	measure 'Non-Refurb Failure Rate' = CALCULATE ( [Product Failure Rate], KEEPFILTERS ( 'Unit Failures'[Build Type] = "Non-Refurb" ) )
		formatString: 0.0%
		displayFolder: Aftersales\4 Refurb vs Non-Refurb
		lineageTag: 6ed4b38d-86ed-42f3-967c-c0d78e36f2f0

	/// Refurb failure rate minus non-refurb failure rate, in percentage points. Positive = refurbs fail more often.
	measure 'Refurb vs Non-Refurb Gap' = VAR R = [Refurb Failure Rate] VAR N = [Non-Refurb Failure Rate] RETURN IF ( ISBLANK ( R ) || ISBLANK ( N ), BLANK (), ( R - N ) * 100 )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Aftersales\4 Refurb vs Non-Refurb
		lineageTag: 9f556a28-b18f-4938-826f-5b3422995422

	/// Share of linked fault tickets that come from refurbished units.
	measure 'Refurb Share of Tickets' = DIVIDE ( CALCULATE ( [Fault Tickets], KEEPFILTERS ( 'Sundesk Tickets'[Build Type] = "Refurb" ) ), [Fault Tickets (Linked)] )
		formatString: 0.0%
		displayFolder: Aftersales\4 Refurb vs Non-Refurb
		lineageTag: 11104ee3-2bfb-4e42-bfbf-afab5b33da4a

	/// Number of slicers in the pane currently narrowing the Installations & Failures page. Ignores the page filter on Install Outcome.
	measure 'Active Filters (Installations)' =
			VAR SelD = FILTERS ( 'AS Calendar'[Date] )
			VAR AllD = ALL ( 'AS Calendar'[Date] )
			VAR FDate =
			    INT (
			        ISFILTERED ( 'AS Calendar'[Date] )
			            && ( MINX ( SelD, 'AS Calendar'[Date] ) > MINX ( AllD, 'AS Calendar'[Date] )
			                || MAXX ( SelD, 'AS Calendar'[Date] ) < MAXX ( AllD, 'AS Calendar'[Date] ) )
			    )
			VAR FOutcome = INT ( COUNTROWS ( FILTERS ( vw_jsf[Install Outcome] ) ) < 2 )
			RETURN
			    FDate + FOutcome
			        + INT ( ISFILTERED ( vw_jsf[Install Failure Reason] ) )
			        + INT ( ISFILTERED ( vw_jsf[Install Failure Category] ) )
			        + INT ( ISFILTERED ( vw_jsf[Install Build Type] ) )
			        + INT ( ISFILTERED ( vw_jsf[Install Product] ) )
			        + INT ( ISFILTERED ( vw_jsf[jsf_engineer] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: fe23ddcc-6174-4cba-9a60-3f933fd6b9d8

	/// Number of slicers in the pane currently narrowing the Product Failure Occurrences page.
	measure 'Active Filters (Failure Occurrences)' =
			VAR SelD = FILTERS ( 'AS Calendar'[Date] )
			VAR AllD = ALL ( 'AS Calendar'[Date] )
			VAR FDate =
			    INT (
			        ISFILTERED ( 'AS Calendar'[Date] )
			            && ( MINX ( SelD, 'AS Calendar'[Date] ) > MINX ( AllD, 'AS Calendar'[Date] )
			                || MAXX ( SelD, 'AS Calendar'[Date] ) < MAXX ( AllD, 'AS Calendar'[Date] ) )
			    )
			RETURN
			    FDate
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Days to Fail Band] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Failure Mode] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Linked Product] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Component] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Component Group] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Build Type] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: bf8e9ec4-28af-468d-98b9-f8e043fe9d86

	/// Number of slicers in the pane currently narrowing the Failure Rates page.
	measure 'Active Filters (Failure Rates)' =
			VAR SelD = FILTERS ( 'AS Calendar'[Date] )
			VAR AllD = ALL ( 'AS Calendar'[Date] )
			VAR FDate =
			    INT (
			        ISFILTERED ( 'AS Calendar'[Date] )
			            && ( MINX ( SelD, 'AS Calendar'[Date] ) > MINX ( AllD, 'AS Calendar'[Date] )
			                || MAXX ( SelD, 'AS Calendar'[Date] ) < MAXX ( AllD, 'AS Calendar'[Date] ) )
			    )
			RETURN
			    FDate
			        + INT ( ISFILTERED ( 'Unit Failures'[Product] ) )
			        + INT ( ISFILTERED ( 'Unit Failures'[Has Faulted] ) )
			        + INT ( ISFILTERED ( 'Unit Failures'[Build Type] ) )
			        + INT ( ISFILTERED ( 'Unit Failures'[First Fault Band] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Component Group] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: e8ef094c-43e1-4a65-94a5-4c6ebf48c009

	/// Number of slicers in the pane currently narrowing the Testing & Repairs Aftersale Tickets page. Ignores the page filter on ticket_group.
	measure 'Active Filters (T&R Tickets)' =
			VAR SelD = FILTER ( FILTERS ( 'Sundesk Tickets'[created_at] ), NOT ISBLANK ( 'Sundesk Tickets'[created_at] ) )
			VAR AllD = FILTER ( ALL ( 'Sundesk Tickets'[created_at] ), NOT ISBLANK ( 'Sundesk Tickets'[created_at] ) )
			VAR FDate =
			    INT (
			        ISFILTERED ( 'Sundesk Tickets'[created_at] )
			            && ( MINX ( SelD, 'Sundesk Tickets'[created_at] ) > MINX ( AllD, 'Sundesk Tickets'[created_at] )
			                || MAXX ( SelD, 'Sundesk Tickets'[created_at] ) < MAXX ( AllD, 'Sundesk Tickets'[created_at] ) )
			    )
			RETURN
			    FDate
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[customer_name] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[ticket_state] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[createdby] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Linked Town] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[product_type] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Build Type] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[JSF Engineer] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[title] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[number] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[JSF ID] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: aac0cba3-85ab-4262-8c77-97fd0228ec92

	/// Number of slicers in the pane currently narrowing the All Aftersale Tickets page. Ignores the page filter on ticket type.
	measure 'Active Filters (All Tickets)' =
			VAR SelD = FILTER ( FILTERS ( 'Sundesk Tickets'[created_at] ), NOT ISBLANK ( 'Sundesk Tickets'[created_at] ) )
			VAR AllD = FILTER ( ALL ( 'Sundesk Tickets'[created_at] ), NOT ISBLANK ( 'Sundesk Tickets'[created_at] ) )
			VAR FDate =
			    INT (
			        ISFILTERED ( 'Sundesk Tickets'[created_at] )
			            && ( MINX ( SelD, 'Sundesk Tickets'[created_at] ) > MINX ( AllD, 'Sundesk Tickets'[created_at] )
			                || MAXX ( SelD, 'Sundesk Tickets'[created_at] ) < MAXX ( AllD, 'Sundesk Tickets'[created_at] ) )
			    )
			RETURN
			    FDate
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[customer_name] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[ticket_state] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[createdby] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[ticket_group] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[product_type] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[Build Type] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[JSF Engineer] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[title] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[number] ) )
			        + INT ( ISFILTERED ( 'Sundesk Tickets'[JSF ID] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: cdba204c-0074-4925-a1dc-3d99d3b647ca

	/// First date on which Testing & Repairs recorded a diagnosis. Everything before this is invisible to the confirmed-failure basis.
	measure 'Confirmation Window Start' =
			CALCULATE ( MIN ( 'Sundesk Tickets'[created_at] ), REMOVEFILTERS (),
			    'Sundesk Tickets'[Confirmed Failure] = "Confirmed Failure" )
		isHidden
		displayFolder: Aftersales\0 Basis
		lineageTag: 97cb3726-3dbc-4e7b-8091-7f6a62349fd1

	/// Every hardware ticket that reached the Testing & Repairs bench, whatever the outcome. Denominator of the confirmation rate.
	measure 'T&R Tickets Assessed' =
			CALCULATE ( DISTINCTCOUNT ( 'Sundesk Tickets'[id] ),
			    KEEPFILTERS ( 'Sundesk Tickets'[ticket_group] = "Operations_KE::Testing & Repairs_KE" ),
			    KEEPFILTERS ( 'Sundesk Tickets'[Fault Class] = "Product Fault" ),
			    REMOVEFILTERS ( 'Sundesk Tickets'[Confirmed Failure] ),
			    USERELATIONSHIP ( 'Sundesk Tickets'[created_at], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: 3e49aa9f-c9db-48eb-9e2a-95e3f0d0e696

	/// Share of bench assessments that ended in a confirmed hardware failure. The rest tested clean, had no cause recorded, or are still open.
	measure 'Confirmation Rate' = DIVIDE ( [Fault Tickets], [T&R Tickets Assessed] )
		formatString: 0.0%
		displayFolder: Aftersales\2 Product Failures
		lineageTag: 9e10f161-f0bc-4c3c-9b91-fe8f95db34dc

	/// Units returned to the bench that tested clean - a diagnosis-at-source cost, not a product cost.
	measure 'No Fault Found' =
			CALCULATE ( DISTINCTCOUNT ( 'Sundesk Tickets'[id] ),
			    KEEPFILTERS ( 'Sundesk Tickets'[Confirmed Failure] = "No Fault Found" ),
			    REMOVEFILTERS ( 'Sundesk Tickets'[Confirmed Failure] ),
			    USERELATIONSHIP ( 'Sundesk Tickets'[created_at], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\2 Product Failures
		lineageTag: 78165856-a2a0-48b0-9eb6-a6cdf44ad66b

	/// Share of bench assessments that tested clean.
	measure 'No Fault Found %' = DIVIDE ( [No Fault Found], [T&R Tickets Assessed] )
		formatString: 0.0%
		displayFolder: Aftersales\2 Product Failures
		lineageTag: 867d41f9-cc7f-4293-aaa8-bdb8e7697f52

	measure 'Units First Failed in Period' =
			
			VAR D1 = MIN ( 'AS Calendar'[Date] )
			VAR D2 = MIN ( MAX ( 'AS Calendar'[Date] ), TODAY () )
			RETURN
			CALCULATE (
			    SUM ( 'Unit Failures'[Units] ),
			    REMOVEFILTERS ( 'AS Calendar' ),
			    KEEPFILTERS (
			        FILTER (
			            ALL ( 'Unit Failures'[First Fault Date] ),
			            NOT ISBLANK ( 'Unit Failures'[First Fault Date] )
			                && 'Unit Failures'[First Fault Date] >= D1
			                && 'Unit Failures'[First Fault Date] <= D2
			        )
			    )
			)
		formatString: 0
		lineageTag: 4aa1ca2f-1a6c-4d98-9ef0-0d9482c2e268

	measure 'Monthly Failure Rate' =
			
			VAR F = [Units First Failed in Period]
			VAR B = [Units Installed Cum]
			RETURN
			IF ( ISBLANK ( B ) || B = 0, BLANK (), DIVIDE ( COALESCE ( F, 0 ), B ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: a28d24d8-6210-49e3-a325-6a2376191b92

