	/// Number of slicers in the pane currently narrowing the All JSFs page.
	measure 'Active Filters (All JSFs)' =
			INT ( ISFILTERED ( vw_jsf[jsf_date] ) && ( MINX ( FILTER ( FILTERS ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) > MINX ( FILTER ( ALL ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) || MAXX ( FILTER ( FILTERS ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) < MAXX ( FILTER ( ALL ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) ) )
			+ INT ( ISFILTERED ( points[region] ) )
			+ INT ( ISFILTERED ( vw_jsf[jsf_engineer2] ) )
			+ INT ( ISFILTERED ( vw_jsf[schedule_type] ) )
			+ INT ( ISFILTERED ( vw_jsf[engineer_recommendation] ) )
			+ INT ( ISFILTERED ( points[accountRef] ) )
		formatString: 0
