	/// Number of slicers in the pane currently narrowing the Warranty Status page.
	measure 'Active Filters (Warranty Status)' =
			INT ( ISFILTERED ( points[warranty_expiry_date] ) && ( MINX ( FILTER ( FILTERS ( points[warranty_expiry_date] ), NOT ISBLANK ( points[warranty_expiry_date] ) ), points[warranty_expiry_date] ) > MINX ( FILTER ( ALL ( points[warranty_expiry_date] ), NOT ISBLANK ( points[warranty_expiry_date] ) ), points[warranty_expiry_date] ) || MAXX ( FILTER ( FILTERS ( points[warranty_expiry_date] ), NOT ISBLANK ( points[warranty_expiry_date] ) ), points[warranty_expiry_date] ) < MAXX ( FILTER ( ALL ( points[warranty_expiry_date] ), NOT ISBLANK ( points[warranty_expiry_date] ) ), points[warranty_expiry_date] ) ) )
			+ INT ( ISFILTERED ( points[sale_date] ) && ( MINX ( FILTER ( FILTERS ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) > MINX ( FILTER ( ALL ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) || MAXX ( FILTER ( FILTERS ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) < MAXX ( FILTER ( ALL ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) ) )
			+ INT ( ISFILTERED ( points[region] ) )
			+ INT ( ISFILTERED ( points[warranty_status] ) )
			+ INT ( ISFILTERED ( points[accountType] ) )
			+ INT ( ISFILTERED ( points[accountRef] ) )
