	/// Number of slicers in the pane currently narrowing the CCRP JSFs page.
	measure 'Active Filters (CCRP JSFs)' =
			INT ( ISFILTERED ( vw_jsf[jsf_date] ) && ( MINX ( FILTER ( FILTERS ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) > MINX ( FILTER ( ALL ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) || MAXX ( FILTER ( FILTERS ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) < MAXX ( FILTER ( ALL ( vw_jsf[jsf_date] ), NOT ISBLANK ( vw_jsf[jsf_date] ) ), vw_jsf[jsf_date] ) ) )
			+ INT ( ISFILTERED ( points[sale_date] ) && ( MINX ( FILTER ( FILTERS ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) > MINX ( FILTER ( ALL ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) || MAXX ( FILTER ( FILTERS ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) < MAXX ( FILTER ( ALL ( points[sale_date] ), NOT ISBLANK ( points[sale_date] ) ), points[sale_date] ) ) )
			+ INT ( ISFILTERED ( points[product] ) )
			+ INT ( ISFILTERED ( points[accountType] ) )
			+ INT ( ISFILTERED ( points[Department_name] ) )
			+ INT ( ISFILTERED ( points[accountRef] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: a32d1468-1fad-476d-bf12-ef40bd1fcb53

	/// Card value with a thousands separator (count of jsf_id).
	measure 'JSF ID Count' = COUNT ( vw_jsf[jsf_id] )
		formatString: #,0
		displayFolder: Report
		lineageTag: 8b1d51b2-ad39-4eb3-9e62-caf8097ca954

	/// Number of slicers in the pane currently narrowing the Cash Release page.
	measure 'Active Filters (Cash Release)' =
			INT ( ISFILTERED ( calendar[Date] ) && ( MINX ( FILTER ( FILTERS ( calendar[Date] ), NOT ISBLANK ( calendar[Date] ) ), calendar[Date] ) > MINX ( FILTER ( ALL ( calendar[Date] ), NOT ISBLANK ( calendar[Date] ) ), calendar[Date] ) || MAXX ( FILTER ( FILTERS ( calendar[Date] ), NOT ISBLANK ( calendar[Date] ) ), calendar[Date] ) < MAXX ( FILTER ( ALL ( calendar[Date] ), NOT ISBLANK ( calendar[Date] ) ), calendar[Date] ) ) )
			+ INT ( ISFILTERED ( vw_jsf[jsf_engineer] ) )
			+ INT ( ISFILTERED ( vw_jsf[jsf_type] ) )
			+ INT ( ISFILTERED ( vw_jsf[jsf_status] ) )
			+ INT ( ISFILTERED ( vw_jsf[engineer_recommendation] ) )
		formatString: 0
		displayFolder: Aftersales\0 Slicer Pane
		lineageTag: 7619bed8-baaa-4003-a2a6-dfca782b2cc2

	/// Card value with a thousands separator (count of JSF ID).
	measure 'Ticket JSF Count' = COUNT ( 'Sundesk Tickets'[JSF ID] )
		formatString: #,0
		displayFolder: Report
		lineageTag: 911ba926-edc0-43e5-a4da-f37273341460

	/// Card value with a thousands separator (count of JSF Assignment ID).
	measure 'Ticket Assignment Count' = COUNT ( 'Sundesk Tickets'[JSF Assignment ID] )
		formatString: #,0
		displayFolder: Report
		lineageTag: 2fe3cadf-b3af-4fc8-827b-0222006126d6

	/// Header text: last model refresh in EAT.
	measure 'Data refreshed' = "Data refreshed " & FORMAT(MAX('Last Refresh'[Refreshed]), "d mmm yyyy, HH:mm") & " EAT"
		displayFolder: Report
		lineageTag: 76937e55-dad0-4966-8347-ef8398f6b541

	/// Units sold: Kenya filters from the page; Category = Unit (pump kits only, no add-ons, financial services or TSR); not Refunded / Rejected; same definition as the Sales Funnel.
	/// When the page Date filter is set, only sales whose sale date falls in that date range count.
	measure '# Sales' =
			VAR _dated = ISFILTERED ( vw_jsf[jsf_date] )
			VAR _from = CALCULATE ( MIN ( vw_jsf[jsf_date] ), ALLSELECTED ( vw_jsf ) )
			VAR _to = CALCULATE ( MAX ( vw_jsf[jsf_date] ), ALLSELECTED ( vw_jsf ) )
			RETURN
			    CALCULATE (
			        SUM ( points[units] ),
			        NOT ISBLANK ( points[sale_date] ),
			        points[Category] = "Unit",
			        NOT points[status] IN { "Refunded", "Rejected" },
			        FILTER ( ALL ( points[sale_date] ), NOT _dated || ( points[sale_date] >= _from && points[sale_date] < _to + 1 ) )
			    )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 5dea20f5-c1e1-43ae-aeb1-d133fbf42abd

	/// Units sold that have been dispatched or installed.
	measure '# Shipped' = CALCULATE ( [# Sales], FILTER ( points, NOT ISBLANK ( points[dispatch_date] ) || points[Install Status] = "Installed" ) )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 5c856c97-cc1e-455f-8684-4e3faefeb2c1

	/// Units sold, not yet dispatched or installed.
	measure '# Pending Dispatch' = IF ( ISBLANK ( [# Sales] ), BLANK (), [# Sales] - COALESCE ( [# Shipped], 0 ) )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 3e7cf693-dff4-408a-a0f7-15e36e7a62dd

	/// Units sold whose account has an Installed JSF.
	measure '# Installed' = CALCULATE ( [# Sales], points[Install Status] = "Installed" )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 6168a5c5-a7cd-4a53-9238-ade52dd0517f

	/// Units sold, not yet installed.
	measure '# Pending Installation' = IF ( ISBLANK ( [# Sales] ), BLANK (), [# Sales] - COALESCE ( [# Installed], 0 ) )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 5b34002c-57c7-48cc-a5ef-46c00816fc0e

	/// Units dispatched, not yet installed.
	measure '# Pending Installation After Dispatch' = IF ( ISBLANK ( [# Sales] ), BLANK (), COALESCE ( [# Shipped], 0 ) - COALESCE ( [# Installed], 0 ) )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 246d0ecb-5efc-4a5c-aaa6-7acae0913b06

	/// Share of units sold that have been dispatched.
	measure '% Dispatched vs Sales' = DIVIDE ( [# Shipped], [# Sales] )
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: f9ddce44-0cff-4a86-b84b-0e7ef53f0cc3

	/// Share of dispatched units that are installed.
	measure '% Installed vs Dispatch' = DIVIDE ( [# Installed], [# Shipped] )
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: 7e20d4ba-4dd0-49e5-86c9-9e53fa7c23f0

	/// Share of units sold that are installed.
	measure '% Installed vs Sales' = DIVIDE ( [# Installed], [# Sales] )
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: c2a9803a-fe20-439f-a3d6-f66b1675f73c

	/// Share of dispatched units still waiting for installation.
	measure '% Pending Installation vs Dispatched' = DIVIDE ( [# Pending Installation After Dispatch], [# Shipped] )
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: 0cef1ec5-c858-4c86-9b85-be2d3c4b84d1

	/// Share of units sold still waiting for installation.
	measure '% Pending Installation vs Sales' = DIVIDE ( [# Pending Installation], [# Sales] )
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: b709f249-aa32-49cb-a9e0-7964a69e7f8b

	/// Card text for First 90 Days. 'Too early' when no selected unit has been in the field 90 days yet; 'No data' when the units were installed before bench diagnosis began.
	measure 'First 90 Days (Card)' =
			VAR R = [Failure Rate (First 90 Days)]
			VAR Oldest = CALCULATE ( MAX ( 'Unit Failures'[Days in Field] ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
			RETURN IF ( NOT ISBLANK ( R ), FORMAT ( R, "0.0%" ), IF ( Oldest < 90, "Too early", "No data" ) )
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: d9628d97-7bbc-4706-9abe-c26aeded3b29

	/// How many of this part are out in the field (units installed in the period x parts per kit). Blank for causes that are not a counted part.
	measure 'Parts in Field' = VAR P = SELECTEDVALUE ( 'Unit Parts'[Part] ) RETURN CALCULATE ( IF ( HASONEVALUE ( 'Unit Parts'[Part] ), SWITCH ( P, "Pump", SUM ( 'Unit Failures'[Pumps] ), "Controller", SUM ( 'Unit Failures'[Controllers] ), "Panel", SUM ( 'Unit Failures'[Panels] ), "TV", SUM ( 'Unit Failures'[TVs] ) ), SUM ( 'Unit Failures'[Pumps] ) + SUM ( 'Unit Failures'[Controllers] ) + SUM ( 'Unit Failures'[Panels] ) + SUM ( 'Unit Failures'[TVs] ) ), USERELATIONSHIP ( 'Unit Failures'[Install Date], 'AS Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Aftersales\5 Parts
		lineageTag: 8ad20668-dae9-467b-9b56-1402f6cacd8f

	/// Units whose FIRST confirmed failure was this part. Each unit counted once.
	measure 'Parts Failed' = CALCULATE ( [Units Failed], TREATAS ( VALUES ( 'Unit Parts'[Part] ), 'Unit Failures'[First Failed Part] ) )
		formatString: #,0
		displayFolder: Aftersales\5 Parts
		lineageTag: f5bf50f5-acc1-4a1d-ab19-dfd495979b1e

	/// Parts Failed / Parts in Field.
	measure 'Part Failure Rate' = DIVIDE ( [Parts Failed], [Parts in Field] )
		formatString: 0.00%
		displayFolder: Aftersales\5 Parts
		lineageTag: 406742fe-2cce-49a6-a437-e2741a08fde0

	/// This part's share of all first failures.
	measure 'Share of Failures' = DIVIDE ( [Parts Failed], CALCULATE ( [Parts Failed], REMOVEFILTERS ( 'Unit Parts' ) ) )
		formatString: 0.0%
		displayFolder: Aftersales\5 Parts
		lineageTag: 8e9803cc-969a-49c7-968d-8baac1104c6d

	/// Part Failure Rate said as '1 in every N'.
	measure 'Part Rate in Words' = VAR R = [Part Failure Rate] RETURN IF ( ISBLANK ( R ) || R = 0, BLANK (), "1 in " & FORMAT ( ROUND ( 1 / R, 0 ), "#,0" ) )
		displayFolder: Aftersales\5 Parts
		lineageTag: 0651e3db-55f5-417c-89cd-d9f82d99255e

	/// Card subtitle: [Cumulative Failure Rate] said as '1 in every N units'.
	measure 'Cumulative Rate in Words' = VAR R = [Cumulative Failure Rate] RETURN IF ( ISBLANK ( R ), "", IF ( R = 0, "No failures yet", "1 in every " & FORMAT ( ROUND ( 1 / R, 0 ), "#,0" ) & " units" ) )
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 9d98b1f3-9ca6-431d-8340-ca2e1b68193f

	/// Card subtitle: [Product Failure Rate] said as '1 in every N units'.
	measure 'Failure Rate in Words' = VAR R = [Product Failure Rate] RETURN IF ( ISBLANK ( R ), "", IF ( R = 0, "No failures yet", "1 in every " & FORMAT ( ROUND ( 1 / R, 0 ), "#,0" ) & " units" ) )
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: 5ceac7a5-4753-4607-bb6f-bf36cbf86494

	/// Card subtitle: [Refurb Failure Rate] said as '1 in every N units'.
	measure 'Refurb Rate in Words' = VAR R = [Refurb Failure Rate] RETURN IF ( ISBLANK ( R ), "", IF ( R = 0, "No failures yet", "1 in every " & FORMAT ( ROUND ( 1 / R, 0 ), "#,0" ) & " units" ) )
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: f6cd8cd1-d49a-4894-b8ce-df951eec7168

	/// Card subtitle: [Non-Refurb Failure Rate] said as '1 in every N units'.
	measure 'Non-Refurb Rate in Words' = VAR R = [Non-Refurb Failure Rate] RETURN IF ( ISBLANK ( R ), "", IF ( R = 0, "No failures yet", "1 in every " & FORMAT ( ROUND ( 1 / R, 0 ), "#,0" ) & " units" ) )
		displayFolder: Aftersales\3 Failure Rates
		lineageTag: d3ecb504-37e9-4232-944b-548b787188fd

	/// Typical days from assignment to JSF (median), so a few very long jobs do not drag the number up.
	measure 'Installation TAT (Median)' = MEDIAN ( vw_jsf[Days Taken] )
		formatString: 0.0
		displayFolder: JSFs
		lineageTag: 94d9ff3f-914d-4990-8695-da6d299c6887

	column 'Aftersales KPIs'
		lineageTag: 3e2b3604-fae7-485e-b161-45cf90afa062
		isNameInferred
		sourceColumn: [Aftersales KPIs]

	partition 'Aftersales KPIs' = calculated
		mode: import
		source = ROW ( "Aftersales KPIs", BLANK () )

