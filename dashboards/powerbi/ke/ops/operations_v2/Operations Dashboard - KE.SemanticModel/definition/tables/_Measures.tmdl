	measure Total_aftersale_tickets = DISTINCTCOUNT('Sundesk Tickets'[id])
		formatString: #,0
		displayFolder: Tickets
		lineageTag: fc20967d-3e9f-4411-8dd1-a5789e9d3da3

	measure Tickets_Within_SLA =
			
			CALCULATE (
			    COUNTROWS ( 'Sundesk Tickets' ),
			    'Sundesk Tickets'[Ticket_SLA_Status] = "Resolved within SLA"
			)
		formatString: #,0
		displayFolder: Tickets
		lineageTag: f6fca40f-ac8d-4705-a9b1-13bf9da0449d

	measure Tickets_Beyond_SLA =
			
			CALCULATE (
			    COUNTROWS ( 'Sundesk Tickets' ),
			    'Sundesk Tickets'[Ticket_SLA_Status] = "Resolved outside SLA"
			)
		formatString: #,0
		displayFolder: Tickets
		lineageTag: 696ff7db-7abe-436c-bd68-e306bcbc45e9

	/// Tickets created in the selected Ticket Date period.
	measure 'Tickets Raised' = [Total_aftersale_tickets]
		formatString: #,##0
		displayFolder: Tickets\Period KPIs
		lineageTag: fbd7c714-2031-4821-bbc1-1533bdbbad6b

	/// Tickets actually closed inside the selected Ticket Date period - the work done in that period, whenever the ticket was raised. With no period selected it counts every ticket that has ever been closed.
	measure 'Tickets Closed' =
			CALCULATE (
			    [Total_aftersale_tickets],
			    USERELATIONSHIP ( 'Sundesk Tickets'[Closed Date], 'Ticket Date'[Date] ),
			    KEEPFILTERS ( NOT ISBLANK ( 'Sundesk Tickets'[Closed Date] ) )
			)
		formatString: #,##0
		displayFolder: Tickets\Period KPIs
		lineageTag: f905e33a-b1ae-4877-9a71-e9d4d11cdebf

	/// Backlog carried out of the period: everything raised up to the period end that had not been closed by the period end.
	measure 'Open at Period End' =
			VAR LastD = MAX ( 'Ticket Date'[Date] )
			VAR DatesToDate =
			    FILTER ( ALL ( 'Ticket Date'[Date] ), NOT ISBLANK ( 'Ticket Date'[Date] ) && 'Ticket Date'[Date] <= LastD )
			VAR RaisedToDate =
			    CALCULATE ( [Total_aftersale_tickets], REMOVEFILTERS ( 'Ticket Date' ), DatesToDate )
			VAR ClosedToDate =
			    CALCULATE (
			        [Total_aftersale_tickets],
			        REMOVEFILTERS ( 'Ticket Date' ),
			        DatesToDate,
			        USERELATIONSHIP ( 'Sundesk Tickets'[Closed Date], 'Ticket Date'[Date] )
			    )
			RETURN
			    RaisedToDate - ClosedToDate
		formatString: #,##0
		displayFolder: Tickets\Period KPIs
		lineageTag: b3e48260-41cc-4b7a-8509-4df3581caaa6

	/// Of the tickets closed in the period, those closed inside the target turnaround.
	measure 'Closed Within SLA' =
			CALCULATE (
			    [Tickets_Within_SLA],
			    USERELATIONSHIP ( 'Sundesk Tickets'[Closed Date], 'Ticket Date'[Date] )
			)
		formatString: #,##0
		displayFolder: Tickets\Period KPIs
		lineageTag: 25bf9c51-029b-47ee-bb88-b16cf34b5901

	/// Of the tickets closed in the period, those closed outside the target turnaround.
	measure 'Closed Beyond SLA' =
			CALCULATE (
			    [Tickets_Beyond_SLA],
			    USERELATIONSHIP ( 'Sundesk Tickets'[Closed Date], 'Ticket Date'[Date] )
			)
		formatString: #,##0
		displayFolder: Tickets\Period KPIs
		lineageTag: 8e9b924b-fa01-483e-80ce-e6f52ae8240d

	/// Of the tickets closed in the period, the share closed inside target. Denominator is tickets closed in the period, so open tickets no longer drag the figure down.
	measure 'SLA Adherence (Closed)' = DIVIDE ( [Closed Within SLA], [Closed Within SLA] + [Closed Beyond SLA] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Tickets\Period KPIs
		lineageTag: 284b4a6b-a142-4518-972b-2a9f30cc2e81

