	column MonthCode =
			
			FORMAT('Calendar'[Date],"yyyy") & "/" &
			FORMAT(MONTH('Calendar'[Date]),"000")
		lineageTag: 936a3caf-37a1-48eb-96e5-bb8f7b27ab92
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition calendar-10b39411-3c31-40ec-a73f-902c789dc6c7 = calculated
		mode: import
		source = ```
				ADDCOLUMNS (CALENDAR("2016-1-1",TODAY()),
				    "Year", FORMAT([Date], "yyyy"), 
				    "MonthNo", MONTH([Date]), 
				    "Month", FORMAT([Date],"MMM"),
				    "Quarter", FORMAT([Date],"\QQ"),
				    "MonthYear", FORMAT([Date],"MMM-YYYY"), 
				    "YearMonth", FORMAT([Date],"YYYYMM"), 
				    "WeekdayNo", WEEKDAY([Date],2), //1-Sun..Sat, 2-Mon..Sat
				    "Weekday", FORMAT([Date],"ddd"), 
				    "WeekNo", WEEKNUM([Date], 2),
				    "Week", "Week " & WEEKNUM([Date], 2),
				    "WeekInMonth","W" &ROUNDUP(DIVIDE(DAY([Date]), 7), 0),
				    "WeekInMonth2","W"&  WEEKNUM ([Date]-1)-WEEKNUM(EOMONTH([Date],-1)+1),
				    "YearWeekNo",FORMAT([Date],"YYYY")&""&WEEKNUM([Date], 2),
				"StartofMonth",EOMONTH([Date],-1)+1,
				"EndofMonth",EOMONTH([Date],0))
				```

