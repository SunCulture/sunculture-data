	/// Month the CDS 2 was completed (yyyy-mm), for the CDS 2 Month slicer.
	column 'CDS2 Month' = IF ( ISBLANK ( 'Customer Data Survey'[cds2CompletionDate] ), BLANK (), FORMAT ( 'Customer Data Survey'[cds2CompletionDate], "yyyy-mm" ) )
		dataType: string
		lineageTag: 8d1e2f30-4a5b-4c6d-9e7f-8091a2b3c403
		summarizeBy: none

	/// Customer Name of the customer's account (accounts_mv.customer_name), looked up once per lead so the survey table does not join every account. Blank when the response has no lead.
	column 'Customer Name' = IF ( ISBLANK ( 'Customer Data Survey'[leadId] ) || 'Customer Data Survey'[leadId] = "", BLANK (), MAXX ( RELATEDTABLE ( accounts_mv ), accounts_mv[customer_name] ) )
		dataType: string
		displayFolder: Customer
		lineageTag: 9e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a50
		summarizeBy: none

	/// Account Ref of the customer's account (accounts_mv.accountRef), looked up once per lead so the survey table does not join every account. Blank when the response has no lead.
	column 'Account Ref' = IF ( ISBLANK ( 'Customer Data Survey'[leadId] ) || 'Customer Data Survey'[leadId] = "", BLANK (), MAXX ( RELATEDTABLE ( accounts_mv ), accounts_mv[accountRef] ) )
		dataType: string
		displayFolder: Customer
		lineageTag: 9e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a51
		summarizeBy: none

	/// Town of the customer's account (accounts_mv.town), looked up once per lead so the survey table does not join every account. Blank when the response has no lead.
	column Town = IF ( ISBLANK ( 'Customer Data Survey'[leadId] ) || 'Customer Data Survey'[leadId] = "", BLANK (), MAXX ( RELATEDTABLE ( accounts_mv ), accounts_mv[town] ) )
		dataType: string
		displayFolder: Customer
		lineageTag: 9e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a52
		summarizeBy: none

	/// Account Type of the customer's account (accounts_mv.accountType), looked up once per lead so the survey table does not join every account. Blank when the response has no lead.
	column 'Account Type' = IF ( ISBLANK ( 'Customer Data Survey'[leadId] ) || 'Customer Data Survey'[leadId] = "", BLANK (), MAXX ( RELATEDTABLE ( accounts_mv ), accounts_mv[accountType] ) )
		dataType: string
		displayFolder: Customer
		lineageTag: 9e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a53
		summarizeBy: none

	/// Country of the customer's account (accounts_mv.companyRegion), looked up once per lead so the survey table does not join every account. Blank when the response has no lead.
	column Country = IF ( ISBLANK ( 'Customer Data Survey'[leadId] ) || 'Customer Data Survey'[leadId] = "", BLANK (), MAXX ( RELATEDTABLE ( accounts_mv ), accounts_mv[companyRegion] ) )
		dataType: string
		displayFolder: Customer
		lineageTag: 9e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a54
