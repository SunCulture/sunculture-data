	/// Yes / No: whether the account's signed contract has been received (customer_contracts Received = Yes); blank when the account is not in the contract register. Read through the contracts relationship.
	column 'Has Received Contract' =
			VAR ref = RELATED ( payg_cystomer_contracts[Account_Ref] )
			RETURN IF ( ISBLANK ( ref ), BLANK (), IF ( RELATED ( payg_cystomer_contracts[Received] ) = "Yes", "Yes", "No" ) )
		lineageTag: 0625b469-8abb-4d40-a751-2cf158d69c1c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

