	column units =
			
			
			var f=if(accounts_mv[productQty]<0||isblank(accounts_mv[productQty]),1,accounts_mv[productQty])
			return
			f
		formatString: 0
		lineageTag: c0ce4584-64b2-4451-8cb7-40852a437994
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column sale_date_only = DATEVALUE( accounts_mv[sale_date] )
		formatString: General Date
		lineageTag: 856a0991-2154-42e6-9d7a-b474d6da0004
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Month the unit was dispatched (yyyy-mm), for the Dispatch Month slicer.
	column 'Dispatch Month' = IF ( ISBLANK ( accounts_mv[dispatchDate] ), BLANK (), FORMAT ( accounts_mv[dispatchDate], "yyyy-mm" ) )
		dataType: string
		lineageTag: 8d1e2f30-4a5b-4c6d-9e7f-8091a2b3c401
		summarizeBy: none

	/// Year of the sale date, for the sales-cohort table.
	column 'Sale Year' = IF ( ISBLANK ( accounts_mv[sale_date_only] ), BLANK (), YEAR ( accounts_mv[sale_date_only] ) )
		dataType: int64
		formatString: 0
		lineageTag: 8d1e2f30-4a5b-4c6d-9e7f-8091a2b3c402
		summarizeBy: none

	partition accounts_mv = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
				    #"e6f716db-6042-41b8-b4b1-633806e1dd39" = #"6b82f3d7-43f9-4345-8122-49f60c0278af"{[dataflowId="e6f716db-6042-41b8-b4b1-633806e1dd39"]}[Data],
				    accounts_mv_ = #"e6f716db-6042-41b8-b4b1-633806e1dd39"{[entity="accounts_mv",version=""]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(accounts_mv_,{{"jsfDate", type date}}),
				    // Only the columns this report uses
				    #"Kept Columns" = Table.SelectColumns(#"Changed Type", {"accountRef", "accountType", "account_id", "companyRegion", "customer_name", "deviceId", "dispatchDate", "jsfDate", "product", "productQty", "sale_date", "status", "leadId", "Region", "category", "region 1", "town"}, MissingField.Ignore),
				    // The dashboard is Kenya only
				    #"Kenya Only" = Table.SelectRows(#"Kept Columns", each [companyRegion] = "kenya"),
				    // An account ref can be reused by a newer account (e.g. 3483116). The contract link needs one row per ref:
				    // the oldest account keeps the plain ref, later ones get "<ref>-<account_id>". All accounts stay in.
				    #"First Account per Ref" = Table.Group(#"Kenya Only", {"accountRef"}, {{"first_account_id", each List.Min([account_id])}}),
				    #"Joined First" = Table.Join(#"Kenya Only", {"accountRef"}, Table.RenameColumns(#"First Account per Ref", {{"accountRef", "ref_key"}}), {"ref_key"}, JoinKind.LeftOuter),
				    #"Unique Ref" = Table.AddColumn(#"Joined First", "accountRef_unique", each if [accountRef] = null or [account_id] = [first_account_id] then [accountRef] else [accountRef] & "-" & Text.From([account_id]), type text),
				    #"Removed Helpers" = Table.RemoveColumns(#"Unique Ref", {"accountRef", "ref_key", "first_account_id"}),
				    #"Unique Account Ref" = Table.RenameColumns(#"Removed Helpers", {{"accountRef_unique", "accountRef"}})
				in
				    #"Unique Account Ref"

	annotation PBI_ResultType = Table

