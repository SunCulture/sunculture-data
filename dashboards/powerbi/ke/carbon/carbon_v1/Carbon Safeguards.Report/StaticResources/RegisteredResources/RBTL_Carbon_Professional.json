{
  "name": "RBTL Carbon Professional",
  "dataColors": [
    "#1B7F5B",
    "#E0A526",
    "#24476B",
    "#D9614C",
    "#8CC9A6",
    "#7A8C86",
    "#3FA7A0",
    "#B5838D",
    "#4F6D7A",
    "#C9B37E"
  ],
  "foreground": "#14302A",
  "foregroundNeutralSecondary": "#5F716B",
  "foregroundNeutralTertiary": "#9AA8A3",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F8F7",
  "backgroundNeutral": "#DDE4E1",
  "tableAccent": "#1B7F5B",
  "hyperlink": "#1B7F5B",
  "visitedHyperlink": "#0E4D3A",
  "good": "#1B7F5B",
  "neutral": "#E0A526",
  "bad": "#D9614C",
  "maximum": "#0E4D3A",
  "center": "#8CC9A6",
  "minimum": "#E8F3ED",
  "null": "#D5DBD8",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#14302A"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#14302A"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#14302A"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F716B"
    },
    "largeTitle": {
      "fontSize": 18,
      "fontFace": "Segoe UI Semibold",
      "color": "#14302A"
    },
    "smallLabel": {
      "fontSize": 8,
      "fontFace": "Segoe UI",
      "color": "#5F716B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DDE4E1"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0E4D3A"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 10,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 90
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#14302A"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#5F716B"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F716B"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F716B"
              }
            },
            "fontSize": 8,
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E6ECE9"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F716B"
              }
            },
            "fontSize": 9,
            "showTitle": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#14302A"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F0"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E3E9E6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F716B"
              }
            },
            "textSize": 8,
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#14302A"
              }
            },
            "textSize": 10,
            "outline": "None"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6ECE9"
              }
            },
            "gridVertical": false,
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E4D3A"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "None",
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#14302A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#14302A"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F8F7"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0E4D3A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E8F3ED"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "outline": "None"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6ECE9"
              }
            },
            "gridVertical": false,
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E4D3A"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "None",
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#14302A"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "None"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#14302A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#14302A"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F8F7"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#0E4D3A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E8F3ED"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0E4D3A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E8F3ED"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "outline": "None"
          }
        ]
      }
    }
  }
}