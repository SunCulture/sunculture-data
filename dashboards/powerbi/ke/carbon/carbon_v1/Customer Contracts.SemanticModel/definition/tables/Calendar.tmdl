	partition Calendar = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MINX(
				        UNION(
				            SELECTCOLUMNS( accounts_mv,              "Date", [jsfDate] ),
				            SELECTCOLUMNS( accounts_mv,              "Date", DATEVALUE( [sale_date] ) ),
				            SELECTCOLUMNS( jsf_mv,                   "Date", [jsf_date_clean] ),
				            SELECTCOLUMNS( payg_cystomer_contracts,  "Date", [JSF_Date] )
				        ),
				        [Date]
				    )
				VAR MaxDate =
				    MAXX(
				        UNION(
				            SELECTCOLUMNS( accounts_mv,              "Date", [jsfDate] ),
				            SELECTCOLUMNS( accounts_mv,              "Date", DATEVALUE( [sale_date] ) ),
				            SELECTCOLUMNS( jsf_mv,                   "Date", [jsf_date_clean] ),
				            SELECTCOLUMNS( payg_cystomer_contracts,  "Date", [JSF_Date] )
				        ),
				        [Date]
				    )
				RETURN
				    ADDCOLUMNS(
				        CALENDAR( MinDate, MaxDate ),
				        "Year",       YEAR( [Date] ),
				        "Month",      MONTH( [Date] ),
				        "Month Name", FORMAT( [Date], "MMMM" ),
				        "Quarter",    "Q" & QUARTER( [Date] ),
				        "Week No",    WEEKNUM( [Date], 2 ),
				        "Day",        DAY( [Date] ),
				        "Day Name",   FORMAT( [Date], "dddd" ),
				        "Year-Month", FORMAT( [Date], "YYYY-MM" )
				    )

	annotation PBI_Id = 4d607f6853c14e3da48d23cc87b7ee39

