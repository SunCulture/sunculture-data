	column 'Has Received Contract' =
			
			VAR CurrentRef = accounts_mv[accountRef]
			VAR AnyRows =
			    COUNTROWS (
			        FILTER (
			            payg_cystomer_contracts,
			            payg_cystomer_contracts[Account_Ref] = CurrentRef
			        )
			    )
			VAR ReceivedCount =
			    COUNTROWS (
			        FILTER (
			            payg_cystomer_contracts,
			            payg_cystomer_contracts[Account_Ref] = CurrentRef
			                && payg_cystomer_contracts[Received] = "Yes"
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( AnyRows ),
			        BLANK (),
			        IF ( ReceivedCount > 0, "Yes", "No" )
			    )
		lineageTag: 0625b469-8abb-4d40-a751-2cf158d69c1c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

