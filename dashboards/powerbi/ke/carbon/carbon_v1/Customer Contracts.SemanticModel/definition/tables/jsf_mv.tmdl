	column jsf_date_clean = DATE(YEAR(jsf_mv[jsf_date]), MONTH(jsf_mv[jsf_date]), DAY(jsf_mv[jsf_date]))
		formatString: General Date
		lineageTag: f102dc7c-999a-466b-97a8-32b009c7214f
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 7a853935-378a-4525-a8fa-6cfcfbe61bbd
			defaultHierarchy: LocalDateTable_7e3defbd-8f88-4612-a515-8501e9283fdc.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Latest Installation Flag' =
			VAR myDev = RELATED ( accounts_mv[deviceId] )
			VAR myAcc = jsf_mv[account_id]
			VAR myDate = jsf_mv[jsf_date]
			VAR myCompleted = jsf_mv[jsf_completed_date]
			VAR myId = jsf_mv[jsf_id]
			RETURN
			IF (
			    jsf_mv[jsf_type] <> "INSTALLATION",
			    1,
			    VAR maxDate =
			        IF (
			            ISBLANK ( myDev ),
			            CALCULATE ( MAX ( jsf_mv[jsf_date] ), REMOVEFILTERS ( jsf_mv ), jsf_mv[jsf_type] = "INSTALLATION", jsf_mv[account_id] = myAcc ),
			            CALCULATE ( MAX ( jsf_mv[jsf_date] ), REMOVEFILTERS ( jsf_mv ), jsf_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] = myDev )
			        )
			    VAR maxCompleted =
			        IF (
			            ISBLANK ( myDev ),
			            CALCULATE ( MAX ( jsf_mv[jsf_completed_date] ), REMOVEFILTERS ( jsf_mv ), jsf_mv[jsf_type] = "INSTALLATION", jsf_mv[account_id] = myAcc, jsf_mv[jsf_date] = maxDate ),
			            CALCULATE ( MAX ( jsf_mv[jsf_completed_date] ), REMOVEFILTERS ( jsf_mv ), jsf_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] = myDev, jsf_mv[jsf_date] = maxDate )
			        )
			    VAR maxId =
			        IF (
			            ISBLANK ( myDev ),
			            CALCULATE ( MAX ( jsf_mv[jsf_id] ), REMOVEFILTERS ( jsf_mv ), jsf_mv[jsf_type] = "INSTALLATION", jsf_mv[account_id] = myAcc, jsf_mv[jsf_date] = maxDate, jsf_mv[jsf_completed_date] = maxCompleted ),
			            CALCULATE ( MAX ( jsf_mv[jsf_id] ), REMOVEFILTERS ( jsf_mv ), jsf_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] = myDev, jsf_mv[jsf_date] = maxDate, jsf_mv[jsf_completed_date] = maxCompleted )
			        )
			    RETURN
			        IF ( myDate = maxDate && myCompleted = maxCompleted && myId = maxId, 1, 0 )
			)
		dataType: int64
		lineageTag: 9a5ecdd4-2b80-4e52-b034-f0596a3cec57
		summarizeBy: none

	column assigned_by_name
		dataType: string
		lineageTag: 0201f9e7-c014-48d3-8c14-19d5d6926b87
		summarizeBy: none
		sourceColumn: assigned_by_name

		annotation SummarizationSetBy = Automatic

	column 'Is Contract' =
			IF(
			    NOT ISBLANK( RELATED( accounts_mv[accountType] ) )
			        && RELATED( accounts_mv[accountType] ) <> "ADDON"
			        && RELATED( accounts_mv[companyRegion] ) = "kenya"
			        && RELATED( accounts_mv[deviceId] ) <> ""
			        && RELATED( accounts_mv[engineer_recommendation] ) = "Installed"
			        && NOT ISBLANK( RELATED( accounts_mv[jsfDate] ) )
			        && jsf_mv[jsf_status] = "COMPLETED"
			        && jsf_mv[jsf_type] = "INSTALLATION"
			        && jsf_mv[Latest Installation Flag] = 1,
			    1,
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: df8e324a-f5e3-4fea-906f-5a62cebb4c58
		summarizeBy: none

	partition jsf_mv = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
