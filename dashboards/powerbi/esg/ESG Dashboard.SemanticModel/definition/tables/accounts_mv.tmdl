		sourceColumn: status

		annotation SummarizationSetBy = Automatic

	/// Gender label for chart legends
	column 'Customer Gender' =
			SWITCH (
			    TRUE (),
			    accounts_mv[gender] IN { "F", "Female" }, "Female",
			    accounts_mv[gender] IN { "M", "Male" }, "Male",
			    "Not recorded"
			)
		dataType: string
		lineageTag: 3d5bf785-98fa-4124-add7-54527a6ade40
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// SUBSCRIPTION accounts are Insurance KE plans; LEASE accounts are pumps rented monthly
	column 'Payment Model' = SWITCH ( accounts_mv[accountType], "PAYG", "PAYG (credit)", "CASH", "Cash", "SUBSCRIPTION", "Subscription (insurance)", "LEASE", "Lease", "CREDIT", "Credit", "Not recorded" )
		dataType: string
		lineageTag: caab9485-a3ed-47a4-a4b3-0f21614fb5ad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Account creation date (links to Calendar)
	column 'Account Date' = DATE ( YEAR ( accounts_mv[createdAt] ), MONTH ( accounts_mv[createdAt] ), DAY ( accounts_mv[createdAt] ) )
		dataType: dateTime
		formatString: Short Date
		lineageTag: 03b80fe4-ef5f-4b1f-88f6-e976af181d74
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Days since installation (job-sheet completion date, else account date) for installed units
	column 'Days In Field' =
			VAR _start = IF ( NOT ISBLANK ( accounts_mv[jsf_completed_date] ), accounts_mv[jsf_completed_date], accounts_mv[createdAt] )
			RETURN
			    IF (
			        accounts_mv[engineer_recommendation] = "Installed" && accounts_mv[jsf_type] = "INSTALLATION",
			        MAX ( 0, DATEDIFF ( MAX ( _start, DATE ( 2016, 1, 1 ) ), TODAY (), DAY ) )
			    )
		dataType: int64
		formatString: #,0
		lineageTag: f854312a-a12c-458d-8282-1bfa334cf1a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition accounts_mv = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
				    #"e6f716db-6042-41b8-b4b1-633806e1dd39" = #"6b82f3d7-43f9-4345-8122-49f60c0278af"{[dataflowId="e6f716db-6042-41b8-b4b1-633806e1dd39"]}[Data],
				    accounts_mv_ = #"e6f716db-6042-41b8-b4b1-633806e1dd39"{[entity="accounts_mv",version=""]}[Data],
				    // Only the columns the ESG dashboard uses (the full view is 100+ columns, incl. photos and personal data)
				    #"Kept Columns" = Table.SelectColumns ( accounts_mv_, {"Full_Deposit_Date", "_generated_at", "accountType", "account_id", "companyRegion", "createdAt", "customerId", "deviceId", "engineer_recommendation", "fullDepositDate", "gender", "identification_number", "jsf_completed_date", "jsf_type", "leadId", "product", "sale_date", "status"}, MissingField.Ignore )
				in
				    #"Kept Columns"

	annotation PBI_ResultType = Table

