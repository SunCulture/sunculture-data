	/// "Homme" (French, Côte d'Ivoire) mapped to Male
	column 'Staff Gender' =
			SWITCH (
			    TRUE (),
			    vw_employees[employee_gender] = "Female", "Female",
			    vw_employees[employee_gender] IN { "Male", "Homme" }, "Male",
			    vw_employees[employee_gender] = "Other", "Other",
			    "Not recorded"
			)
		dataType: string
		lineageTag: 4efa4deb-6167-4a84-9fad-e1d5a8df7ae1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Joined Date' = DATE ( YEAR ( vw_employees[employee_created_date] ), MONTH ( vw_employees[employee_created_date] ), DAY ( vw_employees[employee_created_date] ) )
		dataType: dateTime
		formatString: Short Date
		lineageTag: 34098f08-f35c-4e89-9880-0cf3e6b569c7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Implausible birth dates (<16 or >80 years) treated as blank
	column Age =
			VAR _d = vw_employees[employee_dob]
			VAR _a = IF ( ISBLANK ( _d ) || _d > TODAY (), BLANK (), INT ( YEARFRAC ( _d, TODAY () ) ) )
			RETURN
			    IF ( _a >= 16 && _a <= 80, _a )
		dataType: int64
		formatString: 0
		lineageTag: c3bcd5ca-599f-4e3d-b3a0-ccf332b6ef44
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Band Order' = SWITCH ( TRUE (), ISBLANK ( vw_employees[Age] ), 9, vw_employees[Age] < 25, 1, vw_employees[Age] < 35, 2, vw_employees[Age] < 45, 3, vw_employees[Age] < 55, 4, 5 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: beb43e2e-75d8-4405-a576-013804ec7836
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Band' = SWITCH ( vw_employees[Age Band Order], 1, "Under 25", 2, "25–34", 3, "35–44", 4, "45–54", 5, "55+", "Not recorded" )
		dataType: string
		lineageTag: f026b278-4208-4afb-9144-0f19c4f159e7
		summarizeBy: none
		sortByColumn: 'Age Band Order'

		annotation SummarizationSetBy = Automatic

	/// Grouped from employee_department, which is filled for every user
	column Function =
			VAR _d = vw_employees[employee_department]
			RETURN
			    SWITCH (
			        TRUE (),
			        _d IN { "Field Sales", "UG Field Sales", "STL", "ASR" }, "Field sales",
			        _d IN { "HQ Tele Sales", "UG Telesales", "Yusudi Telesales" }, "Telesales",
			        _d IN { "SSC" }, "SSC",
			        _d IN { "ONE ACRE FUND", "Dealer Agents", "Partner Agent", "Partner", "Digital Agent" }, "Partner, dealer & digital agents",
			        _d IN { "BD Sales Representatives", "Business Development" }, "BD",
			        _d IN { "Trainees", "Trainers" }, "Trainees & trainers",
			        _d IN { "Engineers", "UG Engineers" }, "Engineering",
			        _d IN { "Software Engineering", "TechOps", "I.T", "Data", "QA", "R & D", "Innovation", "Product Management" }, "Product & IT",
			        _d IN { "After Sales", "PAYG", "Collections", "Schedular" }, "CX",
			        _d IN { "Accounts", "UG Accounts", "Warehouse", "UG Supply Chain", "Marketing", "Human Resources", "Fleet and Operations management" }, "Finance, supply chain & corporate",
			        "Other functions"
			    )
		dataType: string
		lineageTag: 636c1421-af42-4f62-bd74-9dcdca1b9044
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// From the phone country code (254 Kenya, 256 Uganda, 225 CIV), else a "UG" department; matches companyRegion values
	column Country =
			VAR _phone = SUBSTITUTE ( SUBSTITUTE ( vw_employees[employee_phone_number], "+", "" ), " ", "" )
			RETURN
			    SWITCH (
			        TRUE (),
			        LEFT ( _phone, 3 ) = "254", "kenya",
			        LEFT ( _phone, 3 ) = "256", "uganda",
			        LEFT ( _phone, 3 ) = "225", "civ",
			        LEFT ( vw_employees[employee_department], 3 ) = "UG ", "uganda",
			        "Not recorded"
			    )
		dataType: string
		lineageTag: d80af768-627e-4b73-acda-ad3e860099b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition vw_employees = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
				    #"bb5dc705-9080-4b0e-9632-2578517a380d" = #"6b82f3d7-43f9-4345-8122-49f60c0278af"{[dataflowId="bb5dc705-9080-4b0e-9632-2578517a380d"]}[Data],
				    vw_employees_ = #"bb5dc705-9080-4b0e-9632-2578517a380d"{[entity="vw_employees",version=""]}[Data]
				in
				    vw_employees_

	annotation PBI_ResultType = Table

