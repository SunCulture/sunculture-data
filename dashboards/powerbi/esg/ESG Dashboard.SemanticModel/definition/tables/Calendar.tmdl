table Calendar
	lineageTag: bcd5458e-b289-4adb-b467-f296f4206892
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 228c7243-22ac-4075-b196-66e58869d733
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 4ae70d8b-b027-4723-95ab-717994568bfc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 286a4ba0-8179-4421-9767-a27d2e8bc19b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column 'Year Month Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3dce1059-820d-4521-a911-dbd2acd6b43d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

		annotation SummarizationSetBy = Automatic

	column 'Year Month'
		dataType: string
		lineageTag: 7d6e91e1-8240-4341-a21a-1d2d9bfbb42f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2018, 1, 1 ), DATE ( YEAR ( TODAY () ), 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Year Month", FORMAT ( [Date], "mmm yyyy" )
				)

