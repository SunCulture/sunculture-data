	/// Cover the policy's product belongs to, from products[name]: Basic Family Care = Hospicash (Turaco), Credit Linked = Life, Gadget = Device, APA / ACRE / El Nino = Climate
	column 'Cover Type' =
			VAR _name = MAXX ( FILTER ( products, products[id] = TRIM ( policies[productId] ) ), products[name] )
			RETURN
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( _name, "Family Care" ), "Hospicash",
			        CONTAINSSTRING ( _name, "Credit Linked" ), "Life",
			        CONTAINSSTRING ( _name, "Gadget" ), "Device",
			        CONTAINSSTRING ( _name, "Climate" ), "Climate",
			        ISBLANK ( _name ), "Unmatched",
			        "Other"
			    )
		lineageTag: dcc1c2e7-adac-4ad7-90ce-e432e774b695
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// First start of the cover (activation date, or creation date when not activated), used for the year-end cut-off
	column 'Policy Date' =
			VAR _d = COALESCE ( policies[dateActivated], policies[createdAt] )
			RETURN
			    IF ( NOT ISBLANK ( _d ), DATE ( YEAR ( _d ), MONTH ( _d ), DAY ( _d ) ) )
		formatString: Long Date
		lineageTag: b215bb35-8e89-403e-9622-a51e1ad95b2f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition policies = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
				    #"ad0b1dd8-fab7-4e5e-8bd5-a380f89cf63d" = #"6b82f3d7-43f9-4345-8122-49f60c0278af"{[dataflowId="ad0b1dd8-fab7-4e5e-8bd5-a380f89cf63d"]}[Data],
				    policies_ = #"ad0b1dd8-fab7-4e5e-8bd5-a380f89cf63d"{[entity="policies",version=""]}[Data],
				    // Only the columns the ESG measures use; the rest made the table too big
				    #"Kept Columns" = Table.SelectColumns ( policies_, {"customerId", "idNumber", "productId", "policyType", "status", "createdAt", "dateActivated"} ),
				    // The dashboard only counts ACTIVE cover
				    #"Active Only" = Table.SelectRows ( #"Kept Columns", each [status] <> null and Text.Upper ( Text.Trim ( [status] ) ) = "ACTIVE" ),
				    #"With Start" = Table.AddColumn ( #"Active Only", "policyStart", each if [dateActivated] <> null then [dateActivated] else [createdAt] ),
				    // Hospicash and Life add a row at every renewal; keep one row per person and product, dated from the first start
				    #"One Row per Cover" = Table.Group ( #"With Start", {"idNumber", "customerId", "productId", "policyType", "status"}, {
				        {"dateActivated", each List.Min ( [policyStart] ), type nullable datetime},
				        {"createdAt", each List.Min ( [createdAt] ), type nullable datetime}
				    } ),
				    #"Typed" = Table.TransformColumnTypes ( #"One Row per Cover", {{"dateActivated", type datetime}, {"createdAt", type datetime}} )
				in
				    #"Typed"

