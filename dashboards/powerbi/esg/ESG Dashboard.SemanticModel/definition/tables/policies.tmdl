table policies
	lineageTag: 36072268-cff9-4846-8709-5f57b73d4b5b

	/// Insurance customer ID number (matched to accounts_mv[identification_number] when a country is picked)
	column idNumber
		dataType: string
		lineageTag: 1124256c-f46a-465a-9563-93c541c72277
		summarizeBy: none
		sourceColumn: idNumber

		annotation SummarizationSetBy = Automatic

	/// Hospicash (Family Care), Life (Credit Linked), Device (Gadget), Climate, Other or Unmatched, from the product name
	column 'Cover Type'
		dataType: string
		lineageTag: dcc1c2e7-adac-4ad7-90ce-e432e774b695
		summarizeBy: none
		sourceColumn: Cover Type

		annotation SummarizationSetBy = Automatic

	/// First start of this cover for the person (activation date, else created date)
	column 'Policy Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: b215bb35-8e89-403e-9622-a51e1ad95b2f
		summarizeBy: none
		sourceColumn: Policy Date

		annotation SummarizationSetBy = Automatic

	partition policies = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
				    #"ad0b1dd8-fab7-4e5e-8bd5-a380f89cf63d" = #"6b82f3d7-43f9-4345-8122-49f60c0278af"{[dataflowId="ad0b1dd8-fab7-4e5e-8bd5-a380f89cf63d"]}[Data],
				    policies_ = #"ad0b1dd8-fab7-4e5e-8bd5-a380f89cf63d"{[entity="policies",version=""]}[Data],
				    // Only the columns needed to place each person's cover
				    #"Kept Columns" = Table.SelectColumns ( policies_, {"idNumber", "productId", "status", "createdAt", "dateActivated"} ),
				    // The dashboard only counts ACTIVE cover
				    #"Active Only" = Table.SelectRows ( #"Kept Columns", each [status] <> null and Text.Upper ( Text.Trim ( [status] ) ) = "ACTIVE" ),
				    // Cover type from the product name (was a DAX column worked out row by row)
				    ProductNames = Table.Buffer ( Table.SelectColumns ( products, {"id", "name"} ) ),
				    #"With Key" = Table.AddColumn ( #"Active Only", "pid", each if [productId] = null then null else Text.Trim ( Text.From ( [productId] ) ), type nullable text ),
				    #"With Product" = Table.NestedJoin ( #"With Key", {"pid"}, ProductNames, {"id"}, "p", JoinKind.LeftOuter ),
				    #"With Name" = Table.ExpandTableColumn ( #"With Product", "p", {"name"}, {"productName"} ),
				    #"With Cover" = Table.AddColumn ( #"With Name", "Cover Type", each
				        if [productName] = null then "Unmatched"
				        else if Text.Contains ( [productName], "Family Care", Comparer.OrdinalIgnoreCase ) then "Hospicash"
				        else if Text.Contains ( [productName], "Credit Linked", Comparer.OrdinalIgnoreCase ) then "Life"
				        else if Text.Contains ( [productName], "Gadget", Comparer.OrdinalIgnoreCase ) then "Device"
				        else if Text.Contains ( [productName], "Climate", Comparer.OrdinalIgnoreCase ) then "Climate"
				        else "Other", type text ),
				    #"With Start" = Table.AddColumn ( #"With Cover", "start", each if [dateActivated] <> null then [dateActivated] else [createdAt] ),
				    // One row per person and cover type, dated from the first start (renewals and repeat products collapse)
				    #"One Row per Person and Cover" = Table.Group ( #"With Start", {"idNumber", "Cover Type"}, {{"Policy Date", each Date.From ( List.Min ( [start] ) ), type nullable date}} ),
				    #"Typed" = Table.TransformColumnTypes ( #"One Row per Person and Cover", {{"idNumber", type text}, {"Cover Type", type text}, {"Policy Date", type date}} )
				in
				    #"Typed"

