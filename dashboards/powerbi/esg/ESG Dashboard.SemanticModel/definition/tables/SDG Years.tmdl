	/// Field parameter for the year columns of the SDG summary: only years up to today, so the new year appears on the first refresh in January
	partition 'SDG Years' = calculated
		mode: import
		source =
				FILTER (
				    {
				        ( "2024", NAMEOF ( 'ESG Measures'[SDG 2024] ), 2024 ),
				        ( "2025", NAMEOF ( 'ESG Measures'[SDG 2025] ), 2025 ),
				        ( "2026", NAMEOF ( 'ESG Measures'[SDG 2026] ), 2026 ),
				        ( "2027", NAMEOF ( 'ESG Measures'[SDG 2027] ), 2027 ),
				        ( "2028", NAMEOF ( 'ESG Measures'[SDG 2028] ), 2028 ),
				        ( "2029", NAMEOF ( 'ESG Measures'[SDG 2029] ), 2029 ),
				        ( "2030", NAMEOF ( 'ESG Measures'[SDG 2030] ), 2030 )
				    },
				    [Value3] <= YEAR ( TODAY () )
				)

	annotation PBI_Id = 9d2e7a413b6c4f1e8a575e1de5d0a104

