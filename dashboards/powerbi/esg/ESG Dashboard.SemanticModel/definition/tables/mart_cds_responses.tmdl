	/// CDS answer is stored as text; converted to a number (0-168 hours a week)
	column 'Weekly Hours Fetching Water' =
			VAR _v = IFERROR ( VALUE ( mart_cds_responses[Hours_spent_fetching_water_every_week__c] ), BLANK () )
			RETURN
			    IF ( _v >= 0 && _v <= 168, _v )
		dataType: double
		formatString: 0.0
		lineageTag: f786c774-4517-4de6-801c-c6ea2ea71e5f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// From the CDS question "Number of loans taken in the last 2 years" (two versions of the field)
	column 'Credit History' =
			VAR _loans =
			    IF (
			        mart_cds_responses[number_of_loans_taken_in_the_last_2yrs_c] <> "",
			        mart_cds_responses[number_of_loans_taken_in_the_last_2yrs_c],
			        mart_cds_responses[Number_of_loans_taken_in_the_last_2yrs__c]
			    )
			RETURN
			    SWITCH ( TRUE (), _loans = "", BLANK (), _loans IN { "0", "0 loans" }, "First-time borrower", "Had prior credit" )
		dataType: string
		lineageTag: 2576a5b7-8798-469c-886f-42d7b1882218
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition mart_cds_responses = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"6b82f3d7-43f9-4345-8122-49f60c0278af" = Workspaces{[workspaceId="6b82f3d7-43f9-4345-8122-49f60c0278af"]}[Data],
				    #"381ab5ac-e517-45dd-bbeb-c054b335280d" = #"6b82f3d7-43f9-4345-8122-49f60c0278af"{[dataflowId="381ab5ac-e517-45dd-bbeb-c054b335280d"]}[Data],
				    mart_cds_responses_ = #"381ab5ac-e517-45dd-bbeb-c054b335280d"{[entity="mart_cds_responses",version=""]}[Data]
				in
				    mart_cds_responses_

