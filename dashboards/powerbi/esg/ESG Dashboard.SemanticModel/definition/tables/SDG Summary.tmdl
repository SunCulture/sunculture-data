	partition 'SDG Summary' = calculated
		mode: import
		source =
				VAR _rows =
				DATATABLE (
				    "Order", INTEGER, "SDG No", INTEGER, "SDG", STRING, "SDG Display", STRING, "KPI", STRING, "Key", STRING, "Unit", STRING, "Basis", STRING, "Note", STRING,
				    {
						{ 1, 1, "SDG 1 – No Poverty", "SDG 1 – No Poverty", "% customers accessing PAYG / credit for the first time", "first_time", "%", "Cumulative", "" },
						{ 2, 1, "SDG 1 – No Poverty", "", "% customers covered under climate insurance (APA, ACRE, El Niño)", "climate", "%", "Cumulative", "" },
						{ 3, 1, "SDG 1 – No Poverty", "", "% customers covered under device insurance (SunCulture Gadget)", "device", "%", "Cumulative", "" },
						{ 4, 1, "SDG 1 – No Poverty", "", "% farmers trained on climate resilience (LearnInk)", "pending", "", "Pending", "Pending – LearnInk training data" },
						{ 5, 1, "SDG 1 – No Poverty", "", "% customers with an additional source of household income", "other_income", "%", "Cumulative", "" },
						{ 6, 2, "SDG 2 – Zero Hunger", "SDG 2 – Zero Hunger", "Active customers", "active", "#", "Snapshot", "" },
						{ 7, 2, "SDG 2 – Zero Hunger", "", "Total sales (sale date + full deposit)", "sales", "#", "Cumulative", "" },
						{ 8, 2, "SDG 2 – Zero Hunger", "", "Kilimo Boost customers (input financing)", "kilimo", "#", "Cumulative", "" },
						{ 9, 3, "SDG 3 – Good Health & Well-being", "SDG 3 – Good Health & Well-being", "Hospicash insurance – customers with active cover (Turaco)", "hospicash", "#", "Cumulative", "" },
						{ 10, 3, "SDG 3 – Good Health & Well-being", "", "Life insurance – families with life benefit cover unlocked", "life", "#", "Cumulative", "" },
						{ 11, 5, "SDG 5 – Gender Equality", "SDG 5 – Gender Equality", "% women sales agents", "women_sales", "%", "Cumulative", "" },
						{ 12, 5, "SDG 5 – Gender Equality", "", "% female customers", "female_cust", "%", "Cumulative", "" },
						{ 13, 5, "SDG 5 – Gender Equality", "", "% female customers accessing PAYG finance", "female_payg", "%", "Cumulative", "" },
						{ 14, 5, "SDG 5 – Gender Equality", "", "Annual recruitment – % of hires who are women", "recruit", "%", "Annual", "" },
						{ 15, 5, "SDG 5 – Gender Equality", "", "% women in leadership (staff who supervise others)", "women_lead", "%", "Snapshot", "" },
						{ 16, 6, "SDG 6 – Clean Water & Sanitation", "SDG 6 – Clean Water & Sanitation", "Customers who bought a water storage tank", "tanks", "#", "Cumulative", "" },
						{ 17, 6, "SDG 6 – Clean Water & Sanitation", "", "Water withdrawn & consumed (m³)", "pending", "", "Pending", "Pending – survey" },
						{ 18, 7, "SDG 7 – Affordable & Clean Energy", "SDG 7 – Affordable & Clean Energy", "Solar irrigation systems deployed", "units", "#", "Cumulative", "" },
						{ 19, 7, "SDG 7 – Affordable & Clean Energy", "", "Clean energy capacity installed", "kw", "kW", "Cumulative", "" },
						{ 20, 7, "SDG 7 – Affordable & Clean Energy", "", "Renewable energy generated", "mwh", "MWh", "Cumulative", "" },
						{ 21, 7, "SDG 7 – Affordable & Clean Energy", "", "% customers replacing diesel / petrol pumps", "diesel", "%", "Cumulative", "" },
						{ 22, 8, "SDG 8 – Decent Work & Economic Growth", "SDG 8 – Decent Work & Economic Growth", "Employee retention rate", "retention", "%", "Snapshot", "" },
						{ 23, 8, "SDG 8 – Decent Work & Economic Growth", "", "Employee turnover rate", "turnover", "%", "Snapshot", "" },
						{ 24, 8, "SDG 8 – Decent Work & Economic Growth", "", "Youth (18–34) representation in workforce", "youth", "%", "Cumulative", "" },
						{ 25, 8, "SDG 8 – Decent Work & Economic Growth", "", "Average daily hours saved through solar irrigation (women)", "hours", "h", "Cumulative", "" },
						{ 26, 8, "SDG 8 – Decent Work & Economic Growth", "", "% employees with written contracts", "pending", "", "Pending", "Pending – P&C records" },
						{ 27, 8, "SDG 8 – Decent Work & Economic Growth", "", "% employees covered by social protection", "pending", "", "Pending", "Pending – P&C records" },
						{ 28, 9, "SDG 9 – Industry, Innovation & Infrastructure", "SDG 9 – Industry, Innovation & Infrastructure", "Device connectivity rate (last 120 days)", "connect", "%", "Snapshot", "" },
						{ 29, 9, "SDG 9 – Industry, Innovation & Infrastructure", "", "Device utilization rate (last 120 days)", "util", "%", "Snapshot", "" },
						{ 30, 9, "SDG 9 – Industry, Innovation & Infrastructure", "", "Average daily pumping hours (last 120 days)", "pumphrs", "h", "Snapshot", "" },
						{ 31, 11, "SDG 11 – Sustainable Cities & Communities", "SDG 11 – Sustainable Cities & Communities", "Waste diversion rate", "pending", "", "Pending", "Pending – needs clarity" },
						{ 32, 13, "SDG 13 – Climate Action", "SDG 13 – Climate Action", "Estimated CO2 emissions avoided", "co2", "t", "Cumulative", "" },
						{ 33, 13, "SDG 13 – Climate Action", "", "Organisational emissions, Scope 1–3 (tCO2e)", "pending", "", "Pending", "Pending – MRV dashboard" },
						{ 34, 17, "SDG 17 – Partnerships for the Goals", "SDG 17 – Partnerships for the Goals", "Climate finance mobilised", "pending", "", "Pending", "Pending – MRV dashboard" }
				    }
				)
				// Official UN SDG colours (un.org/sustainabledevelopment/news/communications-material)
				RETURN
				    ADDCOLUMNS (
				        _rows,
				        "SDG Colour", SWITCH ( [SDG No], 1, "#E5243B", 2, "#DDA63A", 3, "#4C9F38", 5, "#FF3A21", 6, "#26BDE2", 7, "#FCC30B", 8, "#A21942", 9, "#FD6925", 11, "#FD9D24", 13, "#3F7E44", 17, "#19486A", "#A0918A" )
				    )

