		lineageTag: 2cb10bf9-8c4f-48a8-8de0-4701bbed42b9

	/// Installed devices that sent any telemetry (last 120 days)
	measure 'Devices Reporting' = CALCULATE ( DISTINCTCOUNT ( 'IoT Connection'[meterId] ), TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[deviceId] ), accounts_mv[engineer_recommendation] = "Installed", accounts_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] <> "" ), 'IoT Connection'[meterId] ) )
		formatString: #,0
