	measure 'Customers Asked About a Prior Pump' =
			IF (
			    ISFILTERED ( Country[Country] ) || ISFILTERED ( 'Calendar' ),
			    CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[did_you_previously_own_a_water_pump_c] <> "", TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[leadId] ) ), mart_cds_responses[leadId] ) ),
			    CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[did_you_previously_own_a_water_pump_c] <> "" )
			)
		formatString: #,0
