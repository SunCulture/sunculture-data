	/// Same "hours" as the IoT Telemetry dashboard (Hours connected), averaged over days the pump ran
	measure 'Avg Daily Pumping Hours' = CALCULATE ( DIVIDE ( SUM ( 'IoT Usage'[PumpingHours] ), SUM ( 'IoT Usage'[DaysPumping] ) ), TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[deviceId] ), accounts_mv[engineer_recommendation] = "Installed", accounts_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] <> "" ), 'IoT Usage'[meterId] ) )
		formatString: 0.0
		displayFolder: SDG 9 · IoT usage
		lineageTag: 7cbc82a8-e636-45ee-a29f-2fcce2771fcf

	measure 'Avg kWh per Device-Day' = CALCULATE ( DIVIDE ( SUM ( 'IoT Usage'[EnergyKWh] ), SUM ( 'IoT Usage'[DeviceDays] ) ), TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[deviceId] ), accounts_mv[engineer_recommendation] = "Installed", accounts_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] <> "" ), 'IoT Usage'[meterId] ) )
		formatString: 0.000
		displayFolder: SDG 9 · IoT usage
		lineageTag: b2302729-5324-4660-8027-35bfd7d58901

