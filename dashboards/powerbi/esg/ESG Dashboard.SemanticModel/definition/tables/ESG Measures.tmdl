	/// Value of the KPI on the current SDG Summary row; the date window comes from SDG Year-End / SDG Score
	measure 'SDG KPI Value' =
			VAR _k = SELECTEDVALUE ( 'SDG Summary'[Key] )
			VAR _asOf = MAX ( 'Calendar'[Date] )
			RETURN
			    SWITCH (
			        _k,
			        "first_time", [% First-Time Borrowers],
			        "ins_cov", [Insurance Coverage %],
			        "kilimo", [Kilimo Boost Customers],
			        "active", [Active Customers],
			        "sales", [Total Sales],
			        "climate", [% Climate Insurance],
			        "device", [% Device Insurance],
			        "hospicash", [Hospicash Customers],
			        "life", [Life Cover Families],
			        "other_income", [% Additional Income Source],
			        "insured", [Insured Customers],
			        "women_sales", [% Women Sales Agents],
			        "female_cust", [% Female Customers],
			        "female_payg", [% Female PAYG Customers],
			        "recruit", CALCULATE ( [% Women in Workforce], KEEPFILTERS ( 'Calendar'[Year] = YEAR ( _asOf ) ) ),
			        "women_lead", [% Women in Leadership],
			        "hours", [Daily Hours Saved per Woman],
			        "tanks", [Water Tank Customers],
			        "units", [Installed Units],
			        "kw", [Clean Energy Capacity (kW)],
			        "mwh", [Clean Energy Generated (MWh)],
			        "diesel", [% Customers Replacing Fossil-Fuel Pumps],
			        "retention", [Retention Rate],
			        "turnover", [Turnover Rate],
			        "youth", [Youth Share of Workforce],
			        "connect", [Device Connectivity Rate],
			        "util", [Device Utilization Rate],
			        "pumphrs", [Avg Daily Pumping Hours],
			        "co2", [CO2 Avoided (t)],
			        "payg_sales", [PAYG Sales],
			        "first_time_n", [First-Time Borrowers],
			        "female_first", [Female First-Time Borrowers],
			        "women_pue", [Female PUE Sales],
			        "indirect", [Indirect Jobs],
			        "indirect_f", [Indirect Jobs Women],
			        "indirect_m", [Indirect Jobs Men],
			        "direct_f", [Direct Jobs Women],
			        "direct_m", [Direct Jobs Men],
			        "staff_total", [Active Agents & Staff],
			        "pct_female_staff", [% Women in Active Workforce],
			        "female_turnover", [Female Turnover Rate],
			        "refurb", [Second-Life Sales],
			        "mj", [Solar Energy in Year (MJ)]
			    )
		displayFolder: SDG Summary
		lineageTag: 14529bbc-40c7-4a92-a9a8-2b270662324b

	/// Position at 31 Dec of the year in the filter context (today for the current year); with 'SDG Period' = In the year, cumulative counts show only what was added that year. Current-status KPIs and Pending notes only show in the current year, because no history is kept
	measure 'SDG Year-End' =
			VAR _u = SELECTEDVALUE ( 'SDG Summary'[Unit] )
			VAR _b = SELECTEDVALUE ( 'SDG Summary'[Basis] )
			VAR _y = MAX ( 'Calendar'[Year] )
			VAR _isCurrent = _y = YEAR ( TODAY () )
			VAR _end = MIN ( DATE ( _y, 12, 31 ), TODAY () )
			VAR _mode = SELECTEDVALUE ( 'SDG Period'[Period], "Cumulative to date" )
			VAR _v0 = CALCULATE ( [SDG KPI Value], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Date] <= _end )
			VAR _inYear = _mode = "In the year" && _b = "Cumulative" && _u IN { "#", "kW", "MWh", "t" }
			VAR _v = IF ( _inYear, _v0 - CALCULATE ( [SDG KPI Value], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Date] <= DATE ( _y - 1, 12, 31 ) ), _v0 )
			RETURN
			    IF (
			        HASONEVALUE ( 'SDG Summary'[Key] ),
			        SWITCH (
			            TRUE (),
			            _b = "Pending", IF ( _isCurrent, SELECTEDVALUE ( 'SDG Summary'[Note] ), "–" ),
			            _b = "Snapshot" && NOT _isCurrent, "–",
			            ISBLANK ( _v ), "–",
			            _u = "%", FORMAT ( _v, "0.0%" ),
			            _u = "h", FORMAT ( _v, "0.0" ) & " hrs",
			            _u = "kW", FORMAT ( _v, "#,0" ) & " kW",
			            _u = "MWh", FORMAT ( _v, "#,0" ) & " MWh",
			            _u = "t", FORMAT ( _v, "#,0" ) & " t",
			            _u = "MJ", FORMAT ( _v, "#,0" ) & " MJ",
			            FORMAT ( _v, "#,0" )
			        )
			    )
		isHidden
		displayFolder: SDG Summary
		lineageTag: 5c681a4f-5164-41b1-954b-89d33b52e0c9

	measure 'SDG Summary Note' =
			VAR _end = IF ( ISFILTERED ( 'Calendar'[Year] ), MIN ( DATE ( MAX ( 'Calendar'[Year] ), 12, 31 ), TODAY () ), TODAY () )
			RETURN
			    "Year columns = position at 31 Dec; current year = position at " & FORMAT ( _end, "d mmm yyyy" )
			        & "   ·   – = current-status KPI (no history kept)   ·   Waiting survey = will come from the SDG impact survey   ·   Pending = data not yet available"
			        & IF ( SELECTEDVALUE ( 'SDG Period'[Period] ) = "In the year", "   ·   Counts show only what was added in each year", "   ·   Counts are cumulative to the date shown" )
		displayFolder: SDG Summary
		lineageTag: e042e9dd-7ef2-487d-acf4-19c0b915c95a

	/// Fleet IoT kWh per device-day × days each installed unit has been in the field up to the period end (today at most)
	measure 'Clean Energy Generated (MWh)' =
			VAR _asOf = MIN ( MAX ( 'Calendar'[Date] ), TODAY () )
			VAR _unitDays =
			    CALCULATE (
			        SUMX (
			            accounts_mv,
			            VAR _s = IF ( NOT ISBLANK ( accounts_mv[jsf_completed_date] ), accounts_mv[jsf_completed_date], accounts_mv[createdAt] )
			            VAR _s2 = IF ( _s < DATE ( 2016, 1, 1 ), DATE ( 2016, 1, 1 ), _s )
			            RETURN IF ( _s2 > _asOf, 0, DATEDIFF ( _s2, _asOf, DAY ) )
			        ),
			        accounts_mv[engineer_recommendation] = "Installed",
			        accounts_mv[jsf_type] = "INSTALLATION",
			        REMOVEFILTERS ( 'Calendar' ),
			        'Calendar'[Date] <= _asOf
			    )
			RETURN
			    CALCULATE ( [Avg kWh per Device-Day], REMOVEFILTERS ( 'Calendar' ) ) * _unitDays / 1000
		formatString: #,0
		displayFolder: SDG 7 & 13 · Clean energy & carbon
		lineageTag: 295406f1-399a-44d9-a619-bdb0a8edcce6

	/// Clean energy × 0.8 t CO2/MWh – UNFCCC AMS-I.A default for displaced diesel generation
	measure 'CO2 Avoided (t)' = [Clean Energy Generated (MWh)] * 0.8
		formatString: #,0
		displayFolder: SDG 7 & 13 · Clean energy & carbon
		lineageTag: 9aa86828-9ac3-4b43-92f8-694e05ddb85a

	/// One measure per year; the 'SDG Years' field parameter shows those up to the current year. After 2030, copy SDG 2030 and add a row to 'SDG Years'
	measure 'SDG 2024' = CALCULATE ( [SDG Year-End], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = 2024 )
		displayFolder: SDG Summary · Years
		lineageTag: 7f3c2a10-5b1e-4c8d-9a21-2024e5d0a024

