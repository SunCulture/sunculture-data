	/// Solar panel watts of every installed unit (Product Guidebook V8; legacy models assumed 330 W) ÷ 1,000
	measure 'Clean Energy Capacity (kW)' = CALCULATE ( SUMX ( accounts_mv, RELATED ( 'Product Watts'[Panel W] ) ), accounts_mv[engineer_recommendation] = "Installed", accounts_mv[jsf_type] = "INSTALLATION" ) / 1000
		formatString: #,0
		displayFolder: SDG 7 & 13 · Clean energy & carbon
		lineageTag: 53045d26-a389-4c51-9ef0-c22bf8f0a074

	measure 'Installed Devices' = CALCULATE ( DISTINCTCOUNT ( accounts_mv[deviceId] ), accounts_mv[engineer_recommendation] = "Installed", accounts_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] <> "" )
		formatString: #,0
