	/// Installed devices that used energy to pump (last 120 days)
	measure 'Devices Pumping' = CALCULATE ( DISTINCTCOUNT ( 'IoT Usage'[meterId] ), 'IoT Usage'[EnergyKWh] > 0, TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[deviceId] ), accounts_mv[engineer_recommendation] = "Installed", accounts_mv[jsf_type] = "INSTALLATION", accounts_mv[deviceId] <> "" ), 'IoT Usage'[meterId] ) )
		formatString: #,0
		displayFolder: SDG 9 · IoT usage
		lineageTag: 50c26a86-4b92-45ca-b5ea-847ae508a4a2

	measure 'Device Utilization Rate' = DIVIDE ( [Devices Pumping], [Installed Devices] )
		formatString: 0.0%
