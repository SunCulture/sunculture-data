	measure 'Sales Agents' = CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), vw_employees[Function] IN { "Field sales", "Telesales", "SSC", "Partner, dealer & digital agents", "BD" } )
		formatString: #,0
