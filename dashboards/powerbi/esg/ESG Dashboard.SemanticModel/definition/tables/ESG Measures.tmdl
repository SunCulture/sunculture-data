	measure 'Youth Share of Workforce' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), vw_employees[Age] >= 18, vw_employees[Age] <= 34 ), CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), NOT ISBLANK ( vw_employees[Age] ) ) )
