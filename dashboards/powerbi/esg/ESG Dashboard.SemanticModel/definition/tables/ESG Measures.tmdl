		lineageTag: 7f3c2a10-5b1e-4c8d-9a21-2029e5d0a029

	measure 'SDG 2030' = CALCULATE ( [SDG Year-End], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = 2030 )
		displayFolder: SDG Summary · Years
		lineageTag: 7f3c2a10-5b1e-4c8d-9a21-2030e5d0a030

	/// Leaders = staff whose AMT id is someone's supervisor (employee_supervisor_id); women ÷ all leaders
	measure '% Women in Leadership' =
			VAR _supervisorIds = CALCULATETABLE ( VALUES ( vw_employees[employee_supervisor_id] ), REMOVEFILTERS ( vw_employees ) )
			VAR _leaders = FILTER ( VALUES ( vw_employees[employee_amt_id] ), vw_employees[employee_amt_id] IN _supervisorIds )
			RETURN
			    DIVIDE (
			        CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), _leaders, vw_employees[employee_gender] = "Female" ),
			        CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), _leaders )
			    )
		formatString: 0.0%
		displayFolder: SDG 5 · Gender
		lineageTag: 4b7e2c91-6a3d-4f58-b0c2-7d1ae5d0a010

	/// CDS: customers naming another household income source ÷ customers who answered (blank, "None", "No" and "N/A" count as no other source)
	measure '% Additional Income Source' =
			VAR _leads = CALCULATETABLE ( VALUES ( accounts_mv[leadId] ) )
			VAR _answered = CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[other_sources_of_income_of_the_household_c] <> "", TREATAS ( _leads, mart_cds_responses[leadId] ) )
			VAR _other =
			    CALCULATE (
			        DISTINCTCOUNT ( mart_cds_responses[leadId] ),
			        mart_cds_responses[other_sources_of_income_of_the_household_c] <> "",
			        NOT mart_cds_responses[other_sources_of_income_of_the_household_c] IN { "None", "No", "N/A", "NA", "Nil", "0" },
			        TREATAS ( _leads, mart_cds_responses[leadId] )
			    )
			RETURN
			    DIVIDE ( _other, _answered )
		formatString: 0.0%
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 4b7e2c91-6a3d-4f58-b0c2-7d1ae5d0a011

	/// A sale is an account with a sale date and a full deposit date, counted on the sale date
	measure 'Total Sales' =
			VAR _from = MIN ( 'Calendar'[Date] )
			VAR _to = MAX ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( accounts_mv[account_id] ),
			        REMOVEFILTERS ( 'Calendar' ),
			        NOT ISBLANK ( accounts_mv[sale_date] ),
			        NOT ISBLANK ( accounts_mv[fullDepositDate] ) || NOT ISBLANK ( accounts_mv[Full_Deposit_Date] ),
			        accounts_mv[sale_date] >= _from,
			        accounts_mv[sale_date] < _to + 1
			    ) + 0
		formatString: #,0
		displayFolder: 0 · Portfolio
		lineageTag: 3148f847-bd04-4b5e-b553-9a37d912c438

	/// Distinct ID numbers with an ACTIVE policy dated on or before the end of the period; filter policies[Cover Type] to pick the cover
	measure 'Active Policyholders' =
			VAR _end = MAX ( 'Calendar'[Date] )
			RETURN
			    IF (
			        ISFILTERED ( Country[Country] ),
			        CALCULATE ( DISTINCTCOUNT ( policies[idNumber] ), policies[Policy Date] <= _end, TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[identification_number] ), REMOVEFILTERS ( 'Calendar' ) ), policies[idNumber] ) ),
			        CALCULATE ( DISTINCTCOUNT ( policies[idNumber] ), policies[Policy Date] <= _end )
			    ) + 0
		formatString: #,0
		isHidden
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 541b6950-55a5-4701-9b4f-34cb8f032e86

	/// APA, ACRE Africa and El Nino climate cover
	measure 'Climate Insured Customers' = CALCULATE ( [Active Policyholders], policies[Cover Type] = "Climate" )
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 0c64663e-0851-4b3b-8e0d-fe613726a5e1

	measure '% Climate Insurance' = DIVIDE ( [Climate Insured Customers], [Active Customers] )
		formatString: 0.0%
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: b3912a48-1782-4135-80d8-74b504576e2a

	/// SunCulture Gadget Insurance
	measure 'Device Insured Customers' = CALCULATE ( [Active Policyholders], policies[Cover Type] = "Device" )
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 2c78c623-701d-492d-aa16-6ff03b66daca

	measure '% Device Insurance' = DIVIDE ( [Device Insured Customers], [Active Customers] )
		formatString: 0.0%
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: d7612ff2-8e28-42de-a37f-3ba06ec5b24d

	/// Basic Family Care Cover (KE & UG), underwritten by Turaco
	measure 'Hospicash Customers' = CALCULATE ( [Active Policyholders], policies[Cover Type] = "Hospicash" )
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 02778c15-e49c-41a3-9820-920e24de0676

	/// Credit Linked cover (KE & UG)
	measure 'Life Cover Families' = CALCULATE ( [Active Policyholders], policies[Cover Type] = "Life" )
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 31ee91ad-1d7e-408c-b135-ccf62c304753

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 8a5aebb4-6261-4980-b798-ca23cb2483e8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = Automatic

	/// PAYG accounts with a sale date and a full deposit (Total Sales rules)
	measure 'PAYG Sales' = CALCULATE ( [Total Sales], accounts_mv[accountType] = "PAYG" ) + 0
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: b8216f2c-df7a-45c7-9736-ffb3ca685ebf

	/// PAYG customers who told CDS they had never taken a loan (survey respondents only)
	measure 'First-Time Borrowers' =
			VAR _paygLeads = CALCULATETABLE ( VALUES ( accounts_mv[leadId] ), accounts_mv[accountType] = "PAYG" )
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[Credit History] = "First-time borrower", TREATAS ( _paygLeads, mart_cds_responses[leadId] ) ) + 0
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 8006578e-e50b-4496-8aa6-27cc4c74f579

	/// First-time borrowers whose account is in a woman's name
	measure 'Female First-Time Borrowers' = CALCULATE ( [First-Time Borrowers], accounts_mv[gender] IN { "F", "Female" } ) + 0
		formatString: #,0
		displayFolder: SDG 5 · Gender
		lineageTag: 6400e1a5-83b7-42e6-a1fb-51fd0567effc

	/// Sales to women of productive-use products (pumps, solar kits, irrigation); TVs, tanks, insurance, farm inputs and service lines excluded
	measure 'Female PUE Sales' = CALCULATE ( [Total Sales], accounts_mv[gender] IN { "F", "Female" }, FILTER ( VALUES ( accounts_mv[product] ), NOT accounts_mv[product] IN { "TV", "TV Refurbished", "Insurance KE", "Farm Products", "UG Extra Items", "UG AfterSales", "Intervention Technicien", "Jifungulie Self Service", "TSR", "TSR Uganda" } && NOT CONTAINSSTRING ( accounts_mv[product], "tank" ) ) ) + 0
		formatString: #,0
		displayFolder: SDG 5 · Gender
		lineageTag: 1f7c46d0-9f11-4a14-ac48-6204770f11f0

	/// Assumption: 1 indirect job per sale
	measure 'Indirect Jobs' = [Total Sales]
		formatString: #,0
		displayFolder: SDG 8 · Jobs
		lineageTag: 30964c53-a468-4fb0-9fdf-411fe4effea6

	/// 1 indirect job per sale to a female customer
	measure 'Indirect Jobs Women' = CALCULATE ( [Total Sales], accounts_mv[gender] IN { "F", "Female" } ) + 0
		formatString: #,0
		displayFolder: SDG 8 · Jobs
		lineageTag: c61196a5-d786-4192-9eb2-413df6364536

	/// 1 indirect job per sale to a male customer
	measure 'Indirect Jobs Men' = CALCULATE ( [Total Sales], accounts_mv[gender] IN { "M", "Male" } ) + 0
		formatString: #,0
		displayFolder: SDG 8 · Jobs
		lineageTag: 87ff16bb-1d33-45ae-a453-983dee59c687

	/// Active agents and staff who are women
	measure 'Direct Jobs Women' = CALCULATE ( [Active Agents & Staff], vw_employees[employee_gender] = "Female" ) + 0
		formatString: #,0
		displayFolder: SDG 8 · Jobs
		lineageTag: 1e66171e-d1a6-4a6d-878d-77a050adb16c

	/// Active agents and staff who are men
	measure 'Direct Jobs Men' = CALCULATE ( [Active Agents & Staff], vw_employees[employee_gender] IN { "Male", "Homme" } ) + 0
		formatString: #,0
		displayFolder: SDG 8 · Jobs
		lineageTag: 67f5a166-7277-4aff-b2d7-6233010f5f6a

	/// Active women ÷ all active agents and staff
	measure '% Women in Active Workforce' = DIVIDE ( [Direct Jobs Women], [Active Agents & Staff] )
		formatString: 0.0%
		displayFolder: SDG 8 · Jobs
		lineageTag: 89c83d85-0532-4d22-b9e8-8da260d4ec27

	/// Women who have left ÷ all women ever on the staff list
	measure 'Female Turnover Rate' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), vw_employees[employee_active_status] = "InActive", vw_employees[employee_gender] = "Female" ), [Female Employees] )
		formatString: 0.0%
		displayFolder: SDG 8 · Jobs
		lineageTag: d4b6a4f1-6c69-499c-8720-8842f0e6895c

	/// Sales of refurbished products (product name says Refurb / Refurbished or ends in - R)
	measure 'Second-Life Sales' = CALCULATE ( [Total Sales], FILTER ( VALUES ( accounts_mv[product] ), CONTAINSSTRING ( accounts_mv[product], "refurb" ) || RIGHT ( accounts_mv[product], 4 ) = " - R" || CONTAINSSTRING ( accounts_mv[product], "-R " ) ) ) + 0
		formatString: #,0
		displayFolder: SDG 12 · Circularity
		lineageTag: 62222617-21d7-4ab8-b8a3-8d4c49ead5bb

	/// Renewable energy generated in the calendar year (MWh at period end − MWh at the previous 31 Dec) × 3,600
	measure 'Solar Energy in Year (MJ)' =
			VAR _asOf = MIN ( MAX ( 'Calendar'[Date] ), TODAY () )
			VAR _prev = CALCULATE ( [Clean Energy Generated (MWh)], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Date] <= DATE ( YEAR ( _asOf ) - 1, 12, 31 ) )
			RETURN
			    ( [Clean Energy Generated (MWh)] - _prev ) * 3600
		formatString: #,0
		displayFolder: SDG 7 & 13 · Clean energy & carbon
		lineageTag: 5c2d0d7d-7ce2-4d40-b14c-547f6ac8991f

	partition 'ESG Measures' = calculated
		mode: import
		source = DATATABLE ( "Placeholder", STRING, { { "" } } )

