	measure '% Women Sales Agents' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( vw_employees[employee_amt_id] ), vw_employees[Function] IN { "Field sales", "Telesales", "SSC", "Partner, dealer & digital agents", "BD" }, vw_employees[employee_gender] = "Female" ), [Sales Agents] )
