table 'ESG Measures'
	lineageTag: b3a6acd4-4b6f-4d5a-87c0-db71e259a666

	/// Distinct customer accounts
	measure 'Customer Accounts' = DISTINCTCOUNT ( accounts_mv[account_id] )
		formatString: #,0
		displayFolder: 0 · Portfolio
		lineageTag: 46d86962-eab4-4908-be1f-debcb123971c

	/// Accounts whose status counts as active: Complete, Complete - Over Paid, Current, Arrears, Advance, Repossession On Hold, Subscription Active
	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( accounts_mv[account_id] ), accounts_mv[status] IN { "Complete", "Completed", "Complete - Over Paid", "Complete Overpaid", "Current", "Arrears", "Advance", "Repossession On Hold", "Subscription Active" } )
		formatString: #,0
		displayFolder: 0 · Portfolio
		lineageTag: 5152c742-0954-49cf-9c1f-1aa2e65c4e5d

	measure 'PAYG Customers' = CALCULATE ( DISTINCTCOUNT ( accounts_mv[account_id] ), accounts_mv[accountType] = "PAYG" )
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: cdce7a10-95fb-495f-abb2-1647584d581a

	/// Proxy until CDS captures prior credit directly: PAYG customers reporting 0 loans in the last 2 years ÷ PAYG customers who answered
	measure '% First-Time Borrowers' =
			VAR _paygLeads = CALCULATETABLE ( VALUES ( accounts_mv[leadId] ), accounts_mv[accountType] = "PAYG" )
			VAR _answered = CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), NOT ISBLANK ( mart_cds_responses[Credit History] ), TREATAS ( _paygLeads, mart_cds_responses[leadId] ) )
			VAR _firstTime = CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[Credit History] = "First-time borrower", TREATAS ( _paygLeads, mart_cds_responses[leadId] ) )
			RETURN
			    DIVIDE ( _firstTime, _answered )
		formatString: 0.0%
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 9a702d4b-22e8-4015-8619-ec1c082d34b9

	/// Interim: distinct ID numbers of ACTIVE SunCulture Protect customers
	measure 'Insured Customers' =
			IF (
			    ISFILTERED ( Country[Country] ),
			    CALCULATE ( DISTINCTCOUNT ( customers[idNumber] ), customers[status] = "ACTIVE", TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[identification_number] ), REMOVEFILTERS ( 'Calendar' ) ), customers[idNumber] ) ),
			    CALCULATE ( DISTINCTCOUNT ( customers[idNumber] ), customers[status] = "ACTIVE" )
			) + 0
		formatString: #,0
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: 7e05dec1-141f-4250-917c-3c943edaeff0

	/// Insured customers ÷ active customers (sheet formula)
	measure 'Insurance Coverage %' = DIVIDE ( [Insured Customers], [Active Customers] )
		formatString: 0.0%
		displayFolder: SDG 1 & 3 · Inclusion & insurance
		lineageTag: a1d27cfc-cb99-4b7f-899a-008af85bb472

	/// Kilimo Boost input financing is sold as product "Farm Products"
	measure 'Kilimo Boost Customers' = CALCULATE ( DISTINCTCOUNT ( accounts_mv[account_id] ), accounts_mv[product] = "Farm Products" ) + 0
		formatString: #,0
		displayFolder: SDG 2 · Food security
		lineageTag: 18d21333-b8b2-41b5-9aac-67f38001a822

	measure 'Female Customers' = CALCULATE ( DISTINCTCOUNT ( accounts_mv[account_id] ), accounts_mv[gender] IN { "F", "Female" } )
