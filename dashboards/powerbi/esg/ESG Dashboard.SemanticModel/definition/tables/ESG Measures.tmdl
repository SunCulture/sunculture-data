	/// CDS has no gender column, so women are identified through their lead on accounts_mv
	measure 'Daily Hours Saved per Woman' =
			VAR _womenLeads = CALCULATETABLE ( VALUES ( accounts_mv[leadId] ), accounts_mv[gender] IN { "F", "Female" } )
			RETURN
			    DIVIDE (
			        CALCULATE ( AVERAGE ( mart_cds_responses[Weekly Hours Fetching Water] ), mart_cds_responses[Weekly Hours Fetching Water] > 0, TREATAS ( _womenLeads, mart_cds_responses[leadId] ) ),
			        7
			    )
		formatString: 0.0
		displayFolder: SDG 5 · Gender
		lineageTag: 7298c00a-4947-4deb-b7a2-57140d1a47fe

	/// CDS: customers who said they owned a pump before AND named diesel or petrol (answers of "No" with a fuel type are not counted)
	measure 'Fossil-Fuel Pumps Replaced' =
			IF (
			    ISFILTERED ( Country[Country] ) || ISFILTERED ( 'Calendar' ),
			    CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[carbon_credit_which_pump_type_c] IN { "Diesel", "Petrol" }, mart_cds_responses[did_you_previously_own_a_water_pump_c] = "Yes", TREATAS ( CALCULATETABLE ( VALUES ( accounts_mv[leadId] ) ), mart_cds_responses[leadId] ) ),
			    CALCULATE ( DISTINCTCOUNT ( mart_cds_responses[leadId] ), mart_cds_responses[carbon_credit_which_pump_type_c] IN { "Diesel", "Petrol" }, mart_cds_responses[did_you_previously_own_a_water_pump_c] = "Yes" )
			) + 0
		formatString: #,0
		displayFolder: SDG 7 & 13 · Clean energy & carbon
		lineageTag: 66608993-c193-4def-be99-f1c9f6fb75d3

	measure '% Customers Replacing Fossil-Fuel Pumps' = DIVIDE ( [Fossil-Fuel Pumps Replaced], [Customers Asked About a Prior Pump] )
		formatString: 0.0%
		displayFolder: SDG 7 & 13 · Clean energy & carbon
		lineageTag: 3968ab1e-2e05-45b1-bac6-d9ec7795b628

